{
  "version": 1,
  "settings": [
    {
      "id": "graphics.quality",
      "label": { "en": "Quality preset", "tr": "Kalite ayarı" },
      "description": { "en": "Sets many graphics options at once.", "tr": "Birçok grafik seçeneğini birden ayarlar." },
      "type": "enum",
      "category": "graphics",
      "default": "high",
      "options": [
        { "value": "low", "label": { "en": "Low", "tr": "Düşük" } },
        { "value": "high", "label": { "en": "High", "tr": "Yüksek" } }
      ]
    },
    {
      "id": "graphics.shadows",
      "label": "Shadows",
      "type": "bool",
      "category": "graphics",
      "default": true
    },
    {
      "id": "graphics.shadow_distance",
      "label": "Shadow distance",
      "type": "int",
      "category": "graphics",
      "default": 50,
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "m",
      "visibleWhen": { "id": "graphics.shadows", "equals": true }
    },
    {
      "id": "graphics.textures",
      "label": "Texture detail",
      "description": "Loaded when the game starts.",
      "type": "enum",
      "category": "graphics",
      "default": "standard",
      "restart": true,
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "high", "label": "High" }
      ]
    },
    {
      "id": "controls.sensitivity",
      "label": "Look sensitivity",
      "type": "float",
      "category": "controls",
      "default": 0.5,
      "min": 0.1,
      "max": 1,
      "step": 0.1
    },
    {
      "id": "controls.recalibrate",
      "label": "Recalibrate the sticks",
      "type": "action",
      "category": "controls"
    },
    {
      "id": "advanced.version",
      "label": "Game version",
      "type": "info",
      "category": "advanced",
      "default": "1.0.0"
    }
  ]
}
