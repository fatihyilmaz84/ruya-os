{
  "app-id": "org.ruyaos.HelloGame",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "hello-game",
  "finish-args": [
    "--socket=wayland",
    "--device=dri",
    "--device=input",
    "--socket=pulseaudio"
  ],
  "modules": [
    {
      "name": "hello-game",
      "buildsystem": "simple",
      "build-commands": [
        "make test",
        "make",
        "make install PREFIX=/app"
      ],
      "sources": [
        { "type": "dir", "path": ".", "skip": ["output", ".flatpak-builder", "build-dir", "repo"] }
      ]
    }
  ]
}
