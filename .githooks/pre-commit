#!/bin/sh
# Refuse a commit while a tracked file has invalid UTF-8, a stray control character or a
# conflict marker (scripts/lint-text.ps1, under a second). Backslashes sent through heredocs
# reached main as control characters again on 2026-11-09 (lead-8), after dev.ps1 test only.
# Enabled per clone with: git config core.hooksPath .githooks
# Linux (WSL) commits without PowerShell skip it; CI and dev.ps1 test still run the lint.
root="$(git rev-parse --show-toplevel)"
if command -v powershell.exe >/dev/null 2>&1; then
    ps=powershell.exe
elif command -v pwsh >/dev/null 2>&1; then
    ps=pwsh
else
    exit 0
fi
"$ps" -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/lint-text.ps1" || {
    echo "pre-commit: lint-text found bad bytes (above). Write text with backslashes through Write/Edit." >&2
    exit 1
}
