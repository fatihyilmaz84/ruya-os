{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruyaos:schema:play-json:1",
  "title": "RuyaOS .play manifest (play.json), format 1",
  "description": "The machine-readable contract of play.json (docs/specs/05-play-packages.md, sections 4, 6 and 8). A draft until the first release. Strict objects (permissions, run, components) refuse unknown keys; everything else ignores them. The crate ruya-play-format is the only parser and applies more rules than a schema can state: the file table, path rules, which files exist, component and disc cross-references, reserved ids and names (the Official tier may use them), file extensions of art, and byte (not character) limits. tests/schema.rs in that crate keeps the numbers and vocabularies below equal to its constants. requirements.installed_mb is not declared: it is computed from play.files, and a manifest that still has it is accepted and the key ignored.",
  "type": "object",
  "required": ["format", "id", "name", "version", "build", "art", "run"],
  "properties": {
    "format": { "description": "Major version of the format; a console that does not know it refuses the package.", "type": "integer", "minimum": 1, "maximum": 1 },
    "id": {
      "description": "Reverse-DNS id, at least three parts. play.<id> must be a valid Flatpak id, so - is allowed only in the last part. Ids starting with org.ruyaos. or play. are reserved (the validator allows them for the Official tier only).",
      "type": "string",
      "maxLength": 120,
      "pattern": "^([A-Za-z_][A-Za-z0-9_]*\\.){2,}[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "name": { "$ref": "#/$defs/localizedName" },
    "version": { "description": "Display text.", "$ref": "#/$defs/line", "maxLength": 32 },
    "build": { "description": "Positive integer that only increases; update ordering uses it.", "type": "integer", "minimum": 1, "maximum": 9007199254740992 },
    "summary": { "$ref": "#/$defs/localizedSummary" },
    "description": { "$ref": "#/$defs/localizedDescription" },
    "developer": { "$ref": "#/$defs/credit" },
    "publisher": { "$ref": "#/$defs/credit" },
    "release_date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "genres": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["action", "adventure", "arcade", "platformer", "puzzle", "racing", "role-playing", "shooter", "simulation", "sports", "strategy", "fighting", "music", "party", "family", "sandbox", "horror", "visual-novel", "retro", "utility", "other"] }
    },
    "tags": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/line", "maxLength": 24 } },
    "languages": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/languageTag" } },
    "players": {
      "type": "object",
      "properties": {
        "min": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max": { "type": "integer", "minimum": 1, "maximum": 64 },
        "modes": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "enum": ["single", "local", "online"] } }
      },
      "required": ["min", "max"]
    },
    "controller": { "enum": ["full", "partial", "none"] },
    "age_rating": {
      "type": "object",
      "required": ["scheme"],
      "properties": {
        "scheme": { "const": "oars-1.1" },
        "content": {
          "type": "object",
          "maxProperties": 40,
          "propertyNames": { "pattern": "^[a-z0-9-]{1,40}$" },
          "additionalProperties": { "enum": ["none", "mild", "moderate", "intense"] }
        }
      }
    },
    "licence": {
      "type": "object",
      "properties": {
        "package": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9.+() :-]+$" },
        "terms_url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "links": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["kind", "url"],
        "properties": {
          "kind": { "enum": ["homepage", "support", "manual", "source", "community", "store", "privacy", "changelog", "donate", "other"] },
          "url": { "$ref": "#/$defs/httpsUrl" }
        }
      }
    },
    "requirements": {
      "description": "Not a strict object. installed_mb, if present, is ignored.",
      "type": "object",
      "properties": {
        "arch": { "const": "x86_64" },
        "min_ram_mb": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "gpu_api": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "enum": ["vulkan", "opengl"] } }
      }
    },
    "art": {
      "description": "Art slots (section 5). Files must be under art/ and listed in play.files. Unknown slots are ignored.",
      "type": "object",
      "required": ["icon"],
      "properties": {
        "icon": { "$ref": "#/$defs/artPath" },
        "logo": { "oneOf": [ { "$ref": "#/$defs/artPath" }, { "type": "object", "maxProperties": 30, "propertyNames": { "$ref": "#/$defs/languageTag" }, "additionalProperties": { "$ref": "#/$defs/artPath" } } ] },
        "hero": { "$ref": "#/$defs/artPath" },
        "cover": { "$ref": "#/$defs/artPath" },
        "screenshots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["file"],
            "properties": { "file": { "$ref": "#/$defs/artPath" }, "caption": { "$ref": "#/$defs/localizedCaption" } }
          }
        },
        "trailer": {
          "type": "object",
          "required": ["file"],
          "properties": { "file": { "$ref": "#/$defs/artPath" }, "poster": { "$ref": "#/$defs/artPath" } }
        },
        "preview": { "$ref": "#/$defs/artPath" }
      }
    },
    "components": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/component" } },
    "run": { "$ref": "#/$defs/run" },
    "permissions": { "$ref": "#/$defs/permissions" },
    "data": {
      "type": "object",
      "properties": {
        "saves": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/dataPath" } },
        "cache": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/dataPath" } }
      }
    },
    "update": {
      "type": "object",
      "properties": {
        "feed": { "$ref": "#/$defs/httpsUrl" },
        "channel": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z0-9._-]+$" }
      }
    }
  },
  "$defs": {
    "line": {
      "description": "Plain text on one line: no control characters, bidi overrides or zero-width characters, no markup, no inline links.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u061C\\u200B-\\u200F\\u202A-\\u202E\\u2060\\u2066-\\u2069\\uFEFF]*$",
      "not": { "pattern": "<[A-Za-z/!]|://" }
    },
    "multiline": {
      "description": "Plain text; a line break (U+000A) is allowed.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0009\\u000B-\\u001F\\u007F-\\u009F\\u00AD\\u061C\\u200B-\\u200F\\u202A-\\u202E\\u2060\\u2066-\\u2069\\uFEFF]*$",
      "not": { "pattern": "<[A-Za-z/!]|://" }
    },
    "languageTag": { "type": "string", "maxLength": 35, "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "localizedName": {
      "description": "Language tag to text; en is required. A name that looks like a system name (Settings, RuyaOS, Store, Home, Guide, Update) is refused unless the package is Official.",
      "type": "object", "required": ["en"], "maxProperties": 30,
      "propertyNames": { "$ref": "#/$defs/languageTag" },
      "additionalProperties": { "$ref": "#/$defs/line", "maxLength": 60 }
    },
    "localizedSummary": {
      "type": "object", "required": ["en"], "maxProperties": 30,
      "propertyNames": { "$ref": "#/$defs/languageTag" },
      "additionalProperties": { "$ref": "#/$defs/line", "maxLength": 140 }
    },
    "localizedDescription": {
      "type": "object", "required": ["en"], "maxProperties": 30,
      "propertyNames": { "$ref": "#/$defs/languageTag" },
      "additionalProperties": { "$ref": "#/$defs/multiline", "maxLength": 4000 }
    },
    "localizedCaption": {
      "type": "object", "required": ["en"], "maxProperties": 30,
      "propertyNames": { "$ref": "#/$defs/languageTag" },
      "additionalProperties": { "$ref": "#/$defs/line", "maxLength": 100 }
    },
    "localizedReason": {
      "type": "object", "required": ["en"], "maxProperties": 30,
      "propertyNames": { "$ref": "#/$defs/languageTag" },
      "additionalProperties": { "$ref": "#/$defs/line", "maxLength": 120 }
    },
    "credit": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "$ref": "#/$defs/line", "maxLength": 80 }, "url": { "$ref": "#/$defs/httpsUrl" } }
    },
    "httpsUrl": {
      "description": "https only; no user name or password, no spaces.",
      "type": "string",
      "maxLength": 2048,
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+([/?#]\\S*)?$"
    },
    "artPath": { "type": "string", "pattern": "^art/[^\\\\:\\u0000-\\u001F]+$" },
    "dataPath": { "type": "string", "maxLength": 1030, "pattern": "^(prefix|data|config):[^/\\\\\\u0000-\\u001F][^\\\\\\u0000-\\u001F]*$", "not": { "pattern": "[:/]\\.{0,2}(/|$)" } },
    "version": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9._+-]+$" },
    "localId": { "type": "string", "maxLength": 32, "pattern": "^[a-z][a-z0-9_-]*$" },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "type": { "enum": ["wine", "proton", "emulator", "engine"] },
        "source": { "enum": ["bundled", "system", "prefer-system", "prefer-bundled", "newest"] },
        "min": { "$ref": "#/$defs/version" },
        "tested": { "$ref": "#/$defs/version" },
        "max_major": { "type": "integer", "minimum": 0 },
        "bundled": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "version", "licence"],
          "properties": {
            "path": { "type": "string", "pattern": "^components/[^\\\\:\\u0000-\\u001F]+$" },
            "version": { "$ref": "#/$defs/version" },
            "licence": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9.+() :-]+$" },
            "source_url": { "$ref": "#/$defs/httpsUrl" }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "source": { "enum": ["system", "prefer-system", "newest"] } } }, "then": { "required": ["min"] } },
        { "if": { "properties": { "source": { "enum": ["bundled", "prefer-system", "prefer-bundled", "newest"] } } }, "then": { "required": ["bundled"] } }
      ]
    },
    "command": {
      "description": "argv, never a shell string. Placeholders: ${payload}, ${component:<id>}, ${data}, ${config}, ${prefix}, ${disc}.",
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": { "type": "string", "maxLength": 4096, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$" }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "command"],
      "properties": {
        "runner": { "enum": ["native", "wine", "proton", "emulator", "engine"] },
        "component": { "$ref": "#/$defs/localId" },
        "command": { "$ref": "#/$defs/command" },
        "cwd": { "type": "string", "pattern": "^\\$\\{(payload|data|config|prefix|component:[a-z][a-z0-9_-]*)\\}(/.*)?$", "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
        "env": {
          "description": "Names are [A-Z][A-Z0-9_]* and not one the platform owns (a deny table, not an allow-list). Values are at most 1024 bytes.",
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "not": { "pattern": "^(PATH|HOME|DISPLAY|XAUTHORITY|WINEPREFIX|WINESERVER|WINELOADER|WINEDLLPATH|WINEARCH|TMPDIR|GCONV_PATH|LOCPATH|NLSPATH)$|^(LD_|XDG_|FLATPAK_|DBUS_|WAYLAND_|PULSE_|PIPEWIRE_|SDL_|STEAM_COMPAT_|PRESSURE_VESSEL_|VK_|MESA_|LIBGL_|GST_|QT_|GTK_|GDK_|GIO_|RUYA_)" }
          },
          "additionalProperties": { "type": "string", "maxLength": 1024, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$" }
        },
        "launch_mode": { "enum": ["fullscreen", "gamescope", "default"] },
        "prefix": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "arch": { "enum": ["win32", "win64"] },
            "template": { "description": "A folder in the package; it never contains dosdevices.", "type": "string", "minLength": 1 },
            "epoch": { "type": "integer", "minimum": 0 }
          }
        },
        "setup": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "command"],
            "properties": { "id": { "$ref": "#/$defs/localId" }, "command": { "$ref": "#/$defs/command" }, "once": { "type": "boolean" } }
          }
        },
        "discs": {
          "description": "Ordered disc images, each a file under payload/ listed in play.files; ${disc} is the first.",
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^payload/.+$" }
        }
      }
    },
    "permissions": {
      "description": "Closed vocabulary. microphone, camera and bluetooth are not in it until the platform maps them.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": { "type": "boolean" },
        "input": { "enum": ["controllers+keyboard-mouse", "controllers", "all-devices"] },
        "removable_media": { "enum": ["none", "read", "write"] },
        "multiarch": { "type": "boolean" },
        "gamemode": { "type": "boolean" },
        "realtime": { "type": "boolean" },
        "devel": { "type": "boolean" },
        "reasons": {
          "type": "object",
          "propertyNames": { "enum": ["network", "input", "removable_media", "multiarch", "gamemode", "realtime", "devel"] },
          "additionalProperties": { "$ref": "#/$defs/localizedReason" }
        }
      }
    }
  }
}
