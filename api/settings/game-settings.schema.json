{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuyaOS game settings, version 1 (experimental, ADR-035)",
  "description": "A game ships this file as /app/share/ruya/settings.json in its Flatpak. The console reads it as untrusted data. JSON Schema cannot say everything: the shell also checks the file size (64 KiB), that ids are unique, that an int or float default lies in min..max, that an enum default is one of its options, that visibleWhen names another setting of the right kind and never forms a cycle. Docs: docs/developers/game-settings.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "settings"],
  "properties": {
    "version": { "const": 1 },
    "settings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/bool" },
          { "$ref": "#/$defs/enum" },
          { "$ref": "#/$defs/int" },
          { "$ref": "#/$defs/float" },
          { "$ref": "#/$defs/action" },
          { "$ref": "#/$defs/info" }
        ]
      }
    }
  },
  "$defs": {
    "plainText": {
      "description": "One line of plain text: no control characters, no line or paragraph separators, no bidirectional marks, embeddings, overrides or isolates.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069]*$"
    },
    "id": { "type": "string", "pattern": "^[a-z0-9_.]{1,64}$" },
    "optionValue": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
    "category": {
      "enum": ["graphics", "display", "controls", "audio", "gameplay", "interface", "accessibility", "advanced"]
    },
    "label": {
      "description": "A string, or { \"en\": ..., \"tr\": ... } (\"en\" is required; other keys are language codes). At most 40 characters each.",
      "oneOf": [
        { "$ref": "#/$defs/plainText", "maxLength": 40 },
        {
          "type": "object",
          "required": ["en"],
          "maxProperties": 16,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$": { "$ref": "#/$defs/plainText", "maxLength": 40 }
          }
        }
      ]
    },
    "description": {
      "description": "Like label, at most 160 characters each.",
      "oneOf": [
        { "$ref": "#/$defs/plainText", "maxLength": 160 },
        {
          "type": "object",
          "required": ["en"],
          "maxProperties": 16,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$": { "$ref": "#/$defs/plainText", "maxLength": 160 }
          }
        }
      ]
    },
    "visibleWhen": {
      "description": "One condition, no expressions: the row is shown while the setting `id` has the value `equals`.",
      "type": "object",
      "required": ["id", "equals"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "equals": { "type": ["boolean", "string", "number"] }
      }
    },
    "unit": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069]*$" },
    "bool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "default", "category"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/description" },
        "category": { "$ref": "#/$defs/category" },
        "visibleWhen": { "$ref": "#/$defs/visibleWhen" },
        "restart": { "type": "boolean" },
        "type": { "const": "bool" },
        "default": { "type": "boolean" }
      }
    },
    "enum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "default", "category", "options"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/description" },
        "category": { "$ref": "#/$defs/category" },
        "visibleWhen": { "$ref": "#/$defs/visibleWhen" },
        "restart": { "type": "boolean" },
        "type": { "const": "enum" },
        "default": { "$ref": "#/$defs/optionValue" },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "$ref": "#/$defs/optionValue" },
              "label": { "$ref": "#/$defs/label" }
            }
          }
        }
      }
    },
    "int": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "default", "category", "min", "max"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/description" },
        "category": { "$ref": "#/$defs/category" },
        "visibleWhen": { "$ref": "#/$defs/visibleWhen" },
        "restart": { "type": "boolean" },
        "type": { "const": "int" },
        "default": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "min": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "max": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "step": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "unit": { "$ref": "#/$defs/unit" }
      }
    },
    "float": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "default", "category", "min", "max"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/description" },
        "category": { "$ref": "#/$defs/category" },
        "visibleWhen": { "$ref": "#/$defs/visibleWhen" },
        "restart": { "type": "boolean" },
        "type": { "const": "float" },
        "default": { "type": "number", "minimum": -1e9, "maximum": 1e9 },
        "min": { "type": "number", "minimum": -1e9, "maximum": 1e9 },
        "max": { "type": "number", "minimum": -1e9, "maximum": 1e9 },
        "step": { "type": "number", "exclusiveMinimum": 0, "maximum": 1e9 },
        "unit": { "$ref": "#/$defs/unit" }
      }
    },
    "action": {
      "description": "A button. It has no value and no default; the game is told when the player presses it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "category"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/description" },
        "category": { "$ref": "#/$defs/category" },
        "visibleWhen": { "$ref": "#/$defs/visibleWhen" },
        "restart": { "type": "boolean" },
        "type": { "const": "action" }
      }
    },
    "info": {
      "description": "A read-only row. `default` is shown until the game publishes a value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "category"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/description" },
        "category": { "$ref": "#/$defs/category" },
        "visibleWhen": { "$ref": "#/$defs/visibleWhen" },
        "restart": { "type": "boolean" },
        "type": { "const": "info" },
        "default": { "$ref": "#/$defs/label" }
      }
    }
  }
}
