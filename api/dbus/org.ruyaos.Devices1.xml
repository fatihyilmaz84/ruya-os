<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.ruyaos.Devices1 — audio outputs and volumes, the network, Bluetooth, storage, device batteries and temperatures.
  Served by ruya-devices on the system bus at /org/ruyaos/Devices1 (blocker B-007: the service
  has Audio, Network, Bluetooth and Batteries; the shell's mock backends follow this contract).
  Contract between shell (Qt/QML) and services (Rust); see docs/specs/03-services-and-apps.md §2.3.

  One bus name and one object, one interface per device class: org.ruyaos.Devices1.Audio now,
  org.ruyaos.Devices1.Network, .Bluetooth, .Storage, .Batteries, .Thermal and .Time next to it. A new
  class is a new interface, so existing clients and their PropertiesChanged filters (which match
  the interface name) are not touched, and each class can be mocked, implemented and tested on
  its own. Shared rules for every interface of this object:
  - status strings are stable API (listed per interface);
  - lists are re-read after a "...Changed" signal; signals carry no payload except what is said.

  org.ruyaos.Devices1.Audio status strings:
    "ok"            success
    "unknown-sink"  no output with that id (SetDefaultSink)
    "invalid"       malformed argument (unknown channel name)
    "failed"        internal error (e.g. PipeWire refused)

  org.ruyaos.Devices1.Network status strings (NetworkManager behind it; WPA2/3-Personal only):
    "ok"               success (Connect: the network is active, State follows by PropertiesChanged)
    "unknown-network"  no network with that id (Connect, Forget)
    "wrong-password"   the key was rejected (or a saved key no longer works)
    "unsupported"      enterprise (802.1X) networks cannot be joined
    "invalid"          malformed argument (e.g. a password for an open network is ignored, but
                       an empty password for a secured network that is not known is invalid)
    "failed"           internal error

  org.ruyaos.Devices1.Bluetooth status strings (BlueZ behind it; "just works" pairing only):
    "ok"              success (Pair: paired, trusted and connected; the list follows by DevicesChanged)
    "unknown-device"  no device with that id in the list (Pair, Forget, Connect, Disconnect)
    "pairing-failed"  the device refused or the pairing was rejected
    "timeout"         the device did not answer in time (Pair, Connect). The service answers it
                      itself after 20 s, before the D-Bus default call timeout (25 s), so clients
                      keep the default timeout and Pair/Connect always get a status, never a
                      D-Bus error. The pairing is cancelled when it times out.
    "unavailable"     Bluetooth is off or there is no adapter (StartScan, Pair, Connect,
                      StartControllerPairing)
    "invalid"         malformed argument (an empty id; a controller-pairing window longer than 300 s)
    "busy"            a controller-pairing window is already open (StartControllerPairing)
    "refused"         the caller is neither root nor the user the service runs as
                      (StartControllerPairing, StopControllerPairing)
    "failed"          internal error, or Connect/Disconnect on a device that is not paired

  org.ruyaos.Devices1.Storage status strings (udisks2 behind it, statvfs for GetSystemUsage; nothing is ever run from a volume):
    "ok"              success (Eject: unmounted and powered off; the volume leaves the list)
    "unknown-volume"  no volume with that id in the list (Eject)
    "busy"            something still uses the volume (Eject); it stays mounted and listed
    "unsupported"     the filesystem is not one we mount, so the volume is listed but never mounted
                      (Eject: nothing to eject, it is safe to unplug)
    "invalid"         malformed argument (an empty id)
    "failed"          internal error, or Eject of a volume that is not removable

  org.ruyaos.Devices1.Time status strings (systemd-timedated, org.freedesktop.timedate1, behind it):
    "ok"         success (SetTimezone: the zone is set; TimezoneChanged follows)
    "invalid"    malformed argument: a name that is not in ListTimezones (SetTimezone)
    "forbidden"  the caller may not set the zone (SetTimezone): neither root nor the shell, or the
                 shell while the active profile is not an admin. Before the first profile exists
                 (first-boot setup) the shell may set it.
    "failed"     internal error (timedated or polkit refused)

  org.ruyaos.Devices1.Batteries status strings: none. The list is the status (UPower behind it;
  an empty list when UPower is not on the bus, never an error).
-->
<node>
  <interface name="org.ruyaos.Devices1.Audio">

    <!--
      Audio outputs, in a stable order. One dictionary per output:
        id          s   stable id, opaque to the shell (e.g. a PipeWire node name)
        name        s   display name, already localised/readable ("TV (HDMI)")
        kind        s   "hdmi" | "analog" | "usb" | "bluetooth"
        is_default  b   true for exactly one output, unless there are none
    -->
    <method name="ListSinks">
      <arg name="sinks" type="aa{sv}" direction="out"/>
    </method>

    <!--
      Make an output the default; running streams move to it. Policy (spec §2.3), applied by the
      service on its own too: a newly connected headset (usb, bluetooth) becomes the default, and
      when the default disappears the previous default comes back. SetDefaultSink records the
      old default as that "previous" one.
    -->
    <method name="SetDefaultSink">
      <arg name="id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- Level of one channel, 0-100 (values above 100 are clamped). channel: "ui" | "ambient" | "media". -->
    <method name="SetChannelVolume">
      <arg name="channel" type="s" direction="in"/>
      <arg name="value" type="u" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- Master volume of the default output, 0-100 (writes above 100 are clamped). -->
    <property name="MasterVolume" type="u" access="readwrite">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <property name="Muted" type="b" access="readwrite">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!-- Per-channel levels, 0-100: keys "ui", "ambient", "media", all always present. Set with SetChannelVolume. -->
    <property name="ChannelVolumes" type="a{su}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!-- An output appeared, disappeared or changed; call ListSinks again. -->
    <signal name="SinksChanged"/>

    <!-- The default output changed (by policy, by SetDefaultSink or from outside). -->
    <signal name="DefaultSinkChanged">
      <arg name="id" type="s"/>
    </signal>

  </interface>
  <interface name="org.ruyaos.Devices1.Network">

    <!--
      Overall connectivity: "disconnected" | "connecting" | "connected" | "limited"
      ("limited" = linked but no internet).
    -->
    <property name="State" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!--
      The connection the console uses, empty when disconnected:
        kind    s   "ethernet" | "wifi"
        name    s   "Wired" or the SSID
        ip      s   IPv4 address, "" if none yet
        signal  u   0-100, Wi-Fi only (absent for ethernet)
    -->
    <property name="Primary" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!--
      Wi-Fi networks in range plus saved ones, strongest first. One dictionary per network:
        id        s   stable id, opaque to the shell
        ssid      s   display name
        signal    u   0-100
        security  s   "open" | "wpa-psk" | "enterprise"
        known     b   a saved connection exists (Connect works without a password)
        active    b   this is the connected network
    -->
    <method name="ListWifi">
      <arg name="networks" type="aa{sv}" direction="out"/>
    </method>

    <!-- Ask for a new scan; the result arrives as NetworksChanged. -->
    <method name="Scan">
      <arg name="status" type="s" direction="out"/>
    </method>

    <!--
      Join a network. password is used for a secured network that is not known and ignored
      otherwise ("" for open or known ones). A successful join saves the network.
    -->
    <method name="Connect">
      <arg name="id" type="s" direction="in"/>
      <arg name="password" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- Remove a saved network (disconnects it when active). -->
    <method name="Forget">
      <arg name="id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- Networks appeared, disappeared or changed (signal, known, active); call ListWifi again. -->
    <signal name="NetworksChanged"/>

  </interface>
  <interface name="org.ruyaos.Devices1.Bluetooth">

    <!--
      Adapter power. Writable (org.freedesktop.DBus.Properties.Set). Switching off disconnects
      every device, stops a running scan and empties the list (ListDevices answers an empty
      list while Powered is false); switching on reconnects paired, trusted devices that are in
      range and brings the list back. A failed Set (no adapter, rfkill blocked) answers a D-Bus
      error. Powered is false when there is no adapter.
    -->
    <property name="Powered" type="b" access="readwrite">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!--
      A scan is running. The service ends it by itself after at most 30 s (and when Powered
      becomes false); StopScan ends it earlier.
    -->
    <property name="Discovering" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!--
      Paired devices and those found by a scan, in a stable order (paired first). One
      dictionary per device:
        id         s   stable id, opaque to the shell (e.g. the BlueZ address)
        name       s   display name
        kind       s   "controller" | "headset" | "audio" | "other"
        paired     b
        connected  b
        trusted    b   may reconnect by itself
        battery    i   0-100, or -1 when the device reports none
      Empty while Powered is false.
    -->
    <method name="ListDevices">
      <arg name="devices" type="aa{sv}" direction="out"/>
    </method>

    <!-- Start discovery; found devices arrive as DevicesChanged. "unavailable" when off. -->
    <method name="StartScan">
      <arg name="status" type="s" direction="out"/>
    </method>

    <method name="StopScan">
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- Pair, trust and connect (spec 03 §2.1). Answers when done or failed. -->
    <method name="Pair">
      <arg name="id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- Disconnect and remove the pairing; the device leaves the list. -->
    <method name="Forget">
      <arg name="id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- Connect / disconnect a paired device. -->
    <method name="Connect">
      <arg name="id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <method name="Disconnect">
      <arg name="id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- A device appeared, disappeared or changed (connected, battery, ...); call ListDevices again. -->
    <signal name="DevicesChanged"/>

    <!--
      Controller pairing window (T-203): pairing a controller with no keyboard, from the first-boot
      wizard, the profile picker or Settings. While the window is open the adapter is pairable
      (never discoverable: a pad in pairing mode advertises and is found by the scan, a bonded pad
      pages the console), a scan runs, and a BlueZ agent (capability NoInputNoOutput, "just works")
      is registered. The service then
        - accepts an incoming pairing only from an input device (Class of Device major class
          Peripheral 0x05: gamepad, keyboard, mouse; for a device without a class, a Bluetooth LE
          appearance in the HID category), marks it trusted and lets the HID connection through;
        - pairs, trusts and connects, by itself, a gamepad that the scan finds in pairing mode;
        - rejects everything else (audio, phones, unknown classes), and every request for a PIN
          or passkey (PIN pairing is not part of this window);
        - removes (Adapter1.RemoveDevice) any device that has bonded during the window and is not an
          input device, and announces it with ControllerPairingRejected: with this agent the kernel
          accepts a just-works pairing by itself and BlueZ never asks the agent.
      Residual risk: the class and the appearance are told by the remote device, so a device that
      claims an input class inside the window can bond, be trusted and act as a keyboard or pad.
      The window is short, never open by default, not discoverable, capped when the shell reopens
      it by itself, and sweeps strangers; it is not a defence against a spoofing device in range.
      The window closes by itself when a controller has paired, when its seconds are up, or on
      StopControllerPairing, and then the adapter's Pairable is what it was before and the agent is
      gone. When the service starts it switches Pairable and Discoverable off, in case a crashed
      one left them on.
    -->

    <!--
      "idle"     no window is open and none ended since the last start/stop
      "open"     the window is open: hold the controller's pairing button
      "paired"   the last window ended because a controller paired (until the next start/stop)
      "timeout"  the last window ended because its time was up (until the next start/stop)
    -->
    <property name="ControllerPairingState" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!--
      A keyboard or a gamepad is connected, over USB or Bluetooth (the console's own virtual
      navigation keyboard does not count). The shell offers controller pairing when it is false.
      Read from the kernel's input devices every two seconds; kept on this interface because the
      shell asks it for the sake of the pairing window.
    -->
    <property name="InputPresent" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!--
      Open the window for `seconds` (0 = the default, 120; at most 300). Status: "ok",
      "unavailable", "invalid", "busy" (a window is open already; it is not changed), "refused"
      (caller), "failed" (the agent or the adapter refused). Only root and the user the service
      runs as (ruya-shell) may call it.
    -->
    <method name="StartControllerPairing">
      <arg name="seconds" type="u" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- Close the window now ("ok" also when none is open; the state becomes "idle"). Same callers. -->
    <method name="StopControllerPairing">
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- A device that is not an input device tried to pair during the window and was refused. -->
    <signal name="ControllerPairingRejected"/>

  </interface>
  <interface name="org.ruyaos.Devices1.Storage">

    <!--
      Removable volumes (one per partition or filesystem) and internal volumes that are mounted
      outside the system paths (the OS itself is not listed), internal first, then in a stable
      order. Only removable volumes with a supported filesystem are mounted, by the service, once
      per plug-in, nosuid,nodev,noexec. One dictionary per volume:
        id           s   stable id, opaque to the shell (e.g. the udisks object name)
        drive        s   the drive this volume lives on (the udisks drive object), opaque to the shell;
                         partitions of one stick share it, so the shell can show one "Drive inserted"
                         for a stick with several partitions
        label        s   display name; the service falls back to the model or "USB drive"
        filesystem   s   "ext4" | "btrfs" | "exfat" | "vfat" | "ntfs" | "unknown" (not supported)
        size_bytes   x   total size
        free_bytes   x   free space; 0 when not mounted
        removable    b   true for USB sticks and cards
        mounted      b   false for an unsupported filesystem
        mount_point  s   "" when not mounted
        read_only    b
    -->
    <method name="ListVolumes">
      <arg name="volumes" type="aa{sv}" direction="out"/>
    </method>

    <!--
      How full the console's own storage is: the filesystem that holds /var, where apps, games and
      profile data live (the OS image is read-only and small and not counted as a volume; this is
      what is left to use). One dictionary, every value x (bytes); a part that is not known is -1:
        total_bytes   x   size of the filesystem (statvfs; read on every call)
        free_bytes    x   what is still free for the shell's user (statvfs; read on every call)
        apps_bytes    x   the system Flatpak installation, /var/lib/flatpak (apps and runtimes;
                          files that are hard links to each other count once)
        data_bytes    x   profile homes, /var/home. Unknown (-1) today: every profile is a Unix user
                          with a 0700 home and the service runs as the shell's user, so it can see
                          the directories but none of their files. A directory that was not fully
                          readable is never reported as a number (it would count only what the
                          service may read). Exact per-profile sizes need a root source
                          (ruya-profiles); until then clients show "other" instead of this part
        system_bytes  x   the rest of what is used: total - free - apps - data, never negative;
                          while data_bytes is -1 it is everything that is neither free nor apps
                          (total - free - apps); -1 while total, free or apps is unknown
      apps_bytes and data_bytes are directory sizes (allocated blocks, symlinks not followed,
      other mounts not entered) computed in the background and kept for 60 s. They are -1 until the
      first measurement has finished (the call never waits for it); a call that finds them older
      than 60 s answers with what it has and starts a new measurement. They are measured again
      when the Store reports InstalledChanged. A directory that cannot be measured, or not fully
      read, is -1; it never makes the call fail.
    -->
    <method name="GetSystemUsage">
      <arg name="usage" type="a{sv}" direction="out"/>
    </method>

    <!--
      A measurement finished and apps_bytes or data_bytes differ from the one before (also the
      first). Call GetSystemUsage again. Not sent for free space alone: it changes all the time,
      so clients read it when they show it.
    -->
    <signal name="SystemUsageChanged"/>

    <!--
      Unmount and power off a removable volume. Answers when done or failed. See the status
      strings in the header; a volume that is "busy" stays as it was.
    -->
    <method name="Eject">
      <arg name="id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- A volume appeared, disappeared or changed (mounted, free space, ...); call ListVolumes again. -->
    <signal name="VolumesChanged"/>

    <!--
      A volume was plugged in (not sent for the volumes present at start). Sent before
      VolumesChanged; one signal per volume (also for a partition with a filesystem we do not
      mount). The shell waits until the volume is in the list and shows one "Drive inserted" per
      drive (the "drive" key of ListVolumes), not one per partition.
    -->
    <signal name="VolumeAdded">
      <arg name="id" type="s"/>
    </signal>

  </interface>
  <interface name="org.ruyaos.Devices1.Batteries">

    <!--
      Batteries of wireless peripherals (UPower behind it), sorted by id: gaming controllers,
      headsets and headphones, speakers, mice, keyboards, remotes and other Bluetooth devices
      (T-223; until then controllers only). The PC's own battery, power supplies, UPSs, monitors
      and phones are not listed. One dictionary per device:
        id       s   stable id, opaque to the shell (the UPower object path)
        name     s   display name (the device model; a word for the kind when it has none)
        kind     s   "controller" | "headset" | "speaker" | "mouse" | "keyboard" | "other"
        percent  u   0-100
        state    s   "charging" | "discharging" | "full" | "unknown"
      A device that has no battery reading, or is gone, is not listed. A Bluetooth device can also
      be in Devices1.Bluetooth.ListDevices (with its own "battery"); this list is the one the
      status cluster uses for every kind, and the low-battery toast for controllers (the other
      kinds toast through Bluetooth).
    -->
    <method name="ListBatteries">
      <arg name="batteries" type="aa{sv}" direction="out"/>
    </method>

    <!-- A device appeared, disappeared or changed (percent, state); call ListBatteries again. -->
    <signal name="BatteriesChanged"/>

  </interface>
  <interface name="org.ruyaos.Devices1.Thermal">

    <!--
      The console's temperatures and fans, read from the kernel's hwmon (and, for the processor, the
      thermal zones as a fallback), and the level they add up to. Read-only, no statuses. The
      service measures and classifies (thresholds in /usr/lib/ruyaos/thermal.toml, replaced value
      by value by /etc/ruyaos/thermal.toml; docs/specs/01-platform.md "Thermal policy"); what the
      console does at each level is the shell's. Fans are never controlled.

      Levels (strings, stable): "normal" | "warm" | "hot" | "critical". A level counts after the
      reading has stayed at or above its threshold for 10 s and clears when it is 5 degrees below it.
      Readings outside -20..125 degrees are ignored.

      One dictionary per sensor, ordered processor, graphics, drives, fans:
        id        s   stable id built from the chip name, the label and the device (never hwmonN),
                      opaque to the shell
        label     s   English role: "Processor" | "Graphics" | "Drive" | "Fan" (the shell translates
                      by class)
        class     s   "cpu" | "gpu" | "ssd" (NVMe, SATA SSD) | "hdd" | "fan"
        value     d   degrees Celsius; rpm for class "fan"
        level     s   this sensor's level; a fan is "normal" except "hot" when it was seen spinning,
                      reads 0 rpm for 30 s and the processor is "warm" or worse
        max_seen  d   the highest valid value since the service started
      The cores, the board's other temperatures and the chip sensors without a threshold are not
      listed. A machine without sensors (a VM) answers an empty list and level "normal".
      Answered from the last reading (sensors are read every 5 s, every 1 s while the level is above
      normal), so the call never waits for the hardware.
    -->
    <method name="ListSensors">
      <arg name="sensors" type="aa{sv}" direction="out"/>
    </method>

    <!-- The worst level of all listed sensors. -->
    <property name="Level" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!--
      Level changed. sensor_id is the sensor that holds the new level (the one with the highest
      level; for "normal": the sensor that held the level before). Not repeated while the level
      stays the same, also when another sensor takes it over. Sent after SensorsChanged.
    -->
    <signal name="LevelChanged">
      <arg name="level" type="s"/>
      <arg name="sensor_id" type="s"/>
    </signal>

    <!--
      The list differs from the one before as shown: a sensor appeared or left, a level changed, a
      temperature by a whole degree or a fan by 10 rpm. Call ListSensors again.
    -->
    <signal name="SensorsChanged"/>

  </interface>
  <interface name="org.ruyaos.Devices1.Time">

    <!--
      The console's time zone (T-213), kept by systemd-timedated (/etc/localtime); the service is the
      shell's narrow door to it. Everything that needs local time (the clock, the update restart
      window, bedtimes) reads the system's zone, so a change here is a change for all of them.
      The clock itself (UTC) is set by chronyd; there is no way to set it from here.
    -->

    <!-- The zone as an IANA name ("Europe/Istanbul", "UTC"); "UTC" when none is set. -->
    <method name="GetTimezone">
      <arg name="name" type="s" direction="out"/>
    </method>

    <!--
      The names the system knows (timedated's ListTimezones, the same as `timedatectl list-timezones`):
      "Region/City" or "Region/Area/City", sorted, plus "UTC". The service caches the list; the shell
      groups it by the part before the first "/".
    -->
    <method name="ListTimezones">
      <arg name="names" type="as" direction="out"/>
    </method>

    <!--
      Sets the zone. name must be in ListTimezones, else "invalid". Allowed for root and for the shell
      (the user the service runs as) while the active profile is an admin (Profiles1), and, for the
      first-boot setup, while no profile exists yet; "forbidden" otherwise. Setting the zone it
      already has is "ok" and sends no signal. The privileged call to timedated is authorised by
      a polkit rule for the user ruya-shell and exactly the action
      org.freedesktop.timedate1.set-timezone.
    -->
    <method name="SetTimezone">
      <arg name="name" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- The system clock is synchronised by NTP (timedated's NTPSynchronized). False on a console
         that has not been online yet: its clock may be wrong, whatever the zone. -->
    <property name="NtpSynchronised" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!-- The zone changed (SetTimezone, or timedatectl run by someone else); call GetTimezone again. -->
    <signal name="TimezoneChanged"/>

  </interface>

</node>
