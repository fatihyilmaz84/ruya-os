<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.ruyaos.Profiles1 — profile list, PIN checks and the active profile.
  Served by ruya-profiles on the system bus at /org/ruyaos/Profiles1.
  Contract between shell (Qt/QML) and services (Rust); see docs/specs/03-services-and-apps.md §1.

  Status strings are stable API:
    "ok"               success
    "wrong-pin"        PIN did not match; attempts_left says how many tries remain before lockout
    "locked-out"       too many failures; retry_after_secs says when the next try is accepted
    "pin-required"     profile has a PIN and none was given
    "unknown-profile"  no such id
    "not-allowed"      caller lacks the rights (e.g. admin check failed)
    "invalid"          malformed argument (e.g. PIN not 4-6 digits, empty name)
    "failed"           internal error (e.g. could not write the store or create the Unix user)
    "full"             CreateGuest only: every guest uid (50000-59999) has been handed out once

  Methods that check a PIN (SwitchTo, VerifyPin, CreateProfile, SetPin, RenameProfile, DeleteProfile, VerifyAdmin) also return attempts_left and
  retry_after_secs. They matter only for "wrong-pin" (attempts_left = tries before lockout) and
  "locked-out" (retry_after_secs = seconds until the next try is accepted, rounded up); they are 0
  otherwise. SwitchTo and VerifyPin additionally report attempts_left with "pin-required".

  Temporary guests (RUY-125, ADR-017 point 7): CreateGuest makes one on demand for a player who
  joins the signed-in session. A temporary guest is a profile user ("ruya-p<N>", the passwd comment
  "RuyaOS profile (guest)", a uid from 50000-59999 that is never handed out twice) with no name and
  no PIN. It is not in ListProfiles; ListGuests lists it. It only joins: SwitchTo, VerifyPin,
  SetPin, RenameProfile and DeleteProfile answer "not-allowed" for it. The service wipes every
  temporary guest (Unix user and home) on Lock, on a SwitchTo that changes ActiveProfile, and when
  it starts; RemoveGuest wipes one. ProfilesChanged follows every create and wipe.
-->
<node>
  <interface name="org.ruyaos.Profiles1">

    <!--
      (id, display name, avatar colour "#rrggbb", role "admin"|"standard"|"guest", has PIN). Temporary
      guests are never listed here (ListGuests); a "guest" role profile is a kept one.
    -->
    <method name="ListProfiles">
      <arg name="profiles" type="a(ssssb)" direction="out"/>
    </method>

    <!-- Make a profile the active one. pin may be "" for profiles without a PIN. -->
    <method name="SwitchTo">
      <arg name="id" type="s" direction="in"/>
      <arg name="pin" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="attempts_left" type="u" direction="out"/>
      <arg name="retry_after_secs" type="u" direction="out"/>
    </method>

    <!--
      Check a profile's PIN and change nothing: ActiveProfile stays as it is. For a player who joins
      the session (ADR-017). "ok" for the right PIN, or for a profile without a PIN (pin ""). A wrong
      PIN counts towards that profile's lockout, the one SwitchTo uses. "not-allowed" for a
      temporary guest, "unknown-profile" for no such id.
    -->
    <method name="VerifyPin">
      <arg name="id" type="s" direction="in"/>
      <arg name="pin" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="attempts_left" type="u" direction="out"/>
      <arg name="retry_after_secs" type="u" direction="out"/>
    </method>

    <!-- Lock the active profile (back to the picker). Wipes every temporary guest. -->
    <method name="Lock"/>

    <!--
      Make a temporary guest; needs no PIN. id is a new profile id ("p<N>", never reused); number
      is the lowest number 1-3 no live temporary guest holds (the shell names it: "Guest" for 1,
      "Guest <n>" otherwise). "not-allowed" when no profile is signed in or 3 temporary guests
      exist already; "full" when the guest uid range is used up; "failed" when the Unix user
      cannot be made (nothing is kept, a half-made user is removed). id is "" and number 0
      unless "ok".
    -->
    <method name="CreateGuest">
      <arg name="status" type="s" direction="out"/>
      <arg name="id" type="s" direction="out"/>
      <arg name="number" type="u" direction="out"/>
    </method>

    <!--
      Wipe one temporary guest: its Unix user, its home and its record. "unknown-profile" when id is
      not a temporary guest (a regular profile is never removed by this); "failed" (the guest stays)
      when the Unix user cannot be removed.
    -->
    <method name="RemoveGuest">
      <arg name="id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- (id, avatar colour "#rrggbb", number) of each live temporary guest, by number. -->
    <method name="ListGuests">
      <arg name="guests" type="a(ssu)" direction="out"/>
    </method>

    <!--
      Create a profile. When no profiles exist (first boot) the admin arguments are ignored and
      role must be "admin". Otherwise admin_id/admin_pin must identify an admin.
      v1 passes admin credentials explicitly; polkit-based authorisation replaces this in Phase 2.
      role "guest" is refused with "not-allowed" (RUY-716: no new kept guests; temporary guests
      come from CreateGuest). Guest-role profiles stored earlier still load, rename and delete.
    -->
    <method name="CreateProfile">
      <arg name="admin_id" type="s" direction="in"/>
      <arg name="admin_pin" type="s" direction="in"/>
      <arg name="name" type="s" direction="in"/>
      <arg name="role" type="s" direction="in"/>
      <arg name="pin" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="id" type="s" direction="out"/>
      <arg name="attempts_left" type="u" direction="out"/>
      <arg name="retry_after_secs" type="u" direction="out"/>
    </method>

    <!-- Change or remove (new_pin = "") a PIN. Admin profiles cannot remove their PIN. -->
    <method name="SetPin">
      <arg name="id" type="s" direction="in"/>
      <arg name="old_pin" type="s" direction="in"/>
      <arg name="new_pin" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="attempts_left" type="u" direction="out"/>
      <arg name="retry_after_secs" type="u" direction="out"/>
    </method>

    <!--
      Rename a profile. The actor (actor_id, authenticated with actor_pin) must be an admin or the
      profile itself. The name follows the CreateProfile rules (trimmed, 1-32 characters, no
      control characters), else "invalid". A non-admin renaming another profile: "not-allowed".
    -->
    <method name="RenameProfile">
      <arg name="actor_id" type="s" direction="in"/>
      <arg name="actor_pin" type="s" direction="in"/>
      <arg name="id" type="s" direction="in"/>
      <arg name="name" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="attempts_left" type="u" direction="out"/>
      <arg name="retry_after_secs" type="u" direction="out"/>
    </method>

    <!--
      Delete a profile, its Unix user and its home directory (no "keep data" option). Admin only.
      "not-allowed" for the last remaining admin and for the currently active profile; unknown id:
      "unknown-profile". "failed" (store unchanged) when the Unix user cannot be removed. Ids are
      never reused. Emits ProfilesChanged on success.
    -->
    <method name="DeleteProfile">
      <arg name="admin_id" type="s" direction="in"/>
      <arg name="admin_pin" type="s" direction="in"/>
      <arg name="id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="attempts_left" type="u" direction="out"/>
      <arg name="retry_after_secs" type="u" direction="out"/>
    </method>

    <!--
      Check that admin_id is an admin and admin_pin is its PIN; nothing changes. For actions of
      other services that the shell gates behind an admin PIN (T-135: a system rollback).
      "not-allowed" when admin_id is unknown or not an admin. Counts towards the shared lockout.
    -->
    <method name="VerifyAdmin">
      <arg name="admin_id" type="s" direction="in"/>
      <arg name="admin_pin" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="attempts_left" type="u" direction="out"/>
      <arg name="retry_after_secs" type="u" direction="out"/>
    </method>

    <!-- Id of the active profile, "" when locked. -->
    <property name="ActiveProfile" type="s" access="read"/>

    <signal name="ProfilesChanged"/>
  </interface>
</node>
