<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.ruyaos.Store1 — the app store: search, install, update, uninstall Flatpak apps.
  Served by ruya-store on the system bus at /org/ruyaos/Store1 (ruya-store, T-134; the shell's mock
  backend follows this contract too).
  Contract between shell (Qt/QML) and services (Rust); see docs/specs/03-services-and-apps.md §4.

  Status strings are stable API:
    "ok"                success (for Install/Uninstall/Update: the job was queued, its result
                        arrives with JobFinished)
    "unknown-app"       no app with that id
    "already-installed" Install of an installed app
    "not-installed"     Uninstall/Update/Rollback of an app that is not installed
    "no-update"         Update of an app with no update available
    "incompatible"      Install/Update of an app whose x-ruya-min-api-level is above this console's
                        RUYA_API_LEVEL (checked after already-installed / not-installed / no-update;
                        Uninstall and Rollback are not gated)
    "busy"              a job for that app is already queued or running
    "forbidden"         the caller is not allowed (AddRemote and the permission changes need an
                        admin; high-risk permissions need the admin PIN at install, which the shell
                        checks via Profiles1)
    "invalid"           malformed argument (for the permission calls also: an unknown key, or a
                        key the app does not ask for: an override never grants)
    "not-withdrawable"  WithdrawPermission/RestorePermission of a key the console leaves alone
    "failed"            internal error

  JobFinished statuses (a job is a queued transaction; there is one transaction queue):
    "ok"                done
    "failed"            internal error
    "network"           the remote could not be reached
    "signature"         a commit or remote failed signature verification
    "missing-runtime"   a runtime the app needs could not be installed
    "disk-full"         not enough space

  Jobs are named by an opaque string returned from Install/Uninstall/Update/Rollback.

  Every list is a plain array and every record an a{sv} dictionary, so fields can be added later
  without breaking clients (unknown keys are ignored). The installed list is re-read after InstalledChanged,
  the catalogue (Search) after CatalogChanged.

  App record (a{sv}), keys:
    id              s    Flatpak application id, e.g. "org.example.Racer"
    name            s    display name
    summary         s    one line
    description     s    long text, plain
    developer       s    developer or publisher name
    source          s    "official" | "community" | "developer" (spec §4.2: the remote's trust level)
    controller      s    "full" | "partial" | "none" (x-ruya-controller / <control>gamepad)
    age_rating      s    OARS summary: "all" | "7+" | "12+" | "16+" | "18+"; absent for an app
                         with no content rating (not rated; a client must not read it as "all")
    permissions     as   (GetApp reads them on first use; the lists carry the ones already read)
                         stable keys, in plain-language order: "network", "home-files",
                         "host-files", "all-devices", "audio", "gamepad", "session-bus", ...
                         (unknown keys are shown by the shell as-is)
    new_permissions as   what the available update adds to the installed version's permissions (same
                         keys as permissions, in the new version's order); empty when the app is
                         not installed, has no update or the update adds nothing. Only GetApp
                         fills it (it reads the installed and the new version's metadata, the new
                         one fresh each time); the lists carry an empty array. A Standard profile
                         needs the admin PIN for an update that adds a high-risk permission.
    installed_size  t    bytes on disk when installed
    download_size   t    bytes an install downloads (flatpak's download-size column); absent = unknown
    version         s    the newest <release> in the remote's AppStream (by timestamp/date, not file
                         order) = what Install gets or the update brings; absent = unknown
    release_date    x    unix seconds of that release; absent = unknown
    release_notes   s    GetApp only: that release's <description> as plain text (paragraphs
                         separated by one blank line, <li> as "• " lines); absent = none
    installed_version s  installed apps only: flatpak's version column, else the version of the
                         catalogue's release when the app is up to date; absent = unknown
    license         s    <project_license> as written (an SPDX expression); absent = none
    categories      as   <categories> in AppStream order, raw names ("Game", "AdventureGame", ...);
                         the shell maps them to words; absent = none
    screenshots     aa{sv} GetApp only: absent from Search and ListInstalled. AppStream order, the
                         type="default" one first, at most 10. Each {image s, thumb s, caption s}:
                         image = URL of the widest <image> with a width of at most 1920 px; if none
                         has one, the type="source" image, whatever its size; if there is none of
                         those, the first <image>. thumb = the narrowest <image> at least 400 px
                         wide; if none is, the same URL as image. A screenshot with no <image> is
                         left out. caption = <caption> or "".
    icon            s    URL (https: or file:) or "" - the shell draws a generated tile then
    tile            s    URL or ""
    hero            s    URL or ""
    installed       b
    update_available b   only ever true when installed
    compatible      b    false when the app's x-ruya-min-api-level is above this console's RUYA_API_LEVEL
                         (os-release): the shell hides it from the lists and its page cannot install
                         it. Absent from an older service: a client reads it as true. Installed apps
                         that no longer fit stay installed. Install and Update of such an app answer
                         "incompatible" (the service refuses, whatever the client does).
    min_api_level   u    the API level the app asks for (x-ruya-min-api-level), 0 = none; always
                         present from this service, absent from an older one (a client reads 0)
-->
<node>
  <interface name="org.ruyaos.Store1">

    <!--
      Apps whose name, summary or id contains the query (case-insensitive). "" returns the whole catalogue.
      options (a{sv}, unknown keys are ignored, {} = no filter):
        controller  s   "any" (default) | "gamepad" (controller "full" or "partial" only)
        limit       u   at most this many apps, 0 = no limit (default)
      A bad value of a known key makes the call fail with org.freedesktop.DBus.Error.InvalidArgs.
    -->
    <method name="Search">
      <arg name="query" type="s" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="apps" type="aa{sv}" direction="out"/>
    </method>

    <!-- One app, with its permissions and (for an installed app with an update) new_permissions
         read now. The shell calls it when an app page opens. status "unknown-app" returns an empty
         dictionary. -->
    <method name="GetApp">
      <arg name="id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="app" type="a{sv}" direction="out"/>
    </method>

    <!-- Every app Flatpak has installed now, whoever installed it: an app installed since the last
         refresh (a .play app from ruya-play, `flatpak install` by hand) is listed too (RUY-854), and
         InstalledChanged is sent once when the answer found one. -->
    <method name="ListInstalled">
      <arg name="apps" type="aa{sv}" direction="out"/>
    </method>

    <!-- Queue an installation. job is "" unless status is "ok". -->
    <method name="Install">
      <arg name="id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="job" type="s" direction="out"/>
    </method>

    <!-- Queue an uninstall; delete_data also removes ~/.var/app/<id> of every profile. A successful
         uninstall also drops the app's permission override (see GetPermissions). -->
    <method name="Uninstall">
      <arg name="id" type="s" direction="in"/>
      <arg name="delete_data" type="b" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="job" type="s" direction="out"/>
    </method>

    <method name="Update">
      <arg name="id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="job" type="s" direction="out"/>
    </method>

    <!-- Go back to an earlier commit of an installed app (no UI yet). -->
    <method name="Rollback">
      <arg name="id" type="s" direction="in"/>
      <arg name="commit" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="job" type="s" direction="out"/>
    </method>

    <!--
      The service's job table: the jobs queued or running and the last finished ones (the 20 most
      recent), oldest first. The shell calls it when it (re)connects, because a client that was away
      (the service restarted, or the shell did) has missed the signals, and replaces what it shows
      by the answer. One dictionary per job:
        id       s   the job name returned by Install/Uninstall/Update/Rollback
        app      s   Flatpak application id
        kind     s   "install" | "remove" (Uninstall) | "update" | "rollback"
        state    s   "queued" | "running" | "finished"
        status   s   "" unless state is "finished", then the JobFinished status ("ok", "failed", ...)
        reason   s   "" or "interrupted": the service died while the job was queued or running and
                     cannot resume Flatpak's transaction. The job then reports state "finished",
                     status "failed" - unless its result is visible in Flatpak (a running install of
                     an installed app, a running remove of an app that is gone): that is status "ok"
                     with no reason. A restarted service never reports a job as queued or running
                     that it did not start itself.
        percent  u   0-100 (100 for an "ok" job, 0 for a queued one)
        phase    s   as JobProgress ("download" | "install" | "update" | "remove")
      Job names continue after a restart (they are never reused). The table is kept in the service's
      state directory, so a finished job can be listed after a restart too. No signal announces a
      restart-time correction: the new bus name owner is the announcement.
    -->
    <method name="ListJobs">
      <arg name="jobs" type="aa{sv}" direction="out"/>
    </method>

    <!--
      Software sources (spec §4.2), one dictionary each:
        name     s   remote name ("ruyaos", "flathub")
        title    s   display name
        trust    s   "official" | "community" | "developer"
        enabled  b
    -->
    <method name="ListRemotes">
      <arg name="remotes" type="aa{sv}" direction="out"/>
    </method>

    <!-- Admin only (no UI yet). Unsigned remotes are refused with status "invalid". -->
    <method name="AddRemote">
      <arg name="name" type="s" direction="in"/>
      <arg name="url" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!--
      Permissions of an installed app (RUY-744, spec 03 §4.4), per console, not per profile. The
      keys are those of the App record's permissions, read from the installed version's Flatpak
      metadata. The console withdraws a permission with a system-wide Flatpak override
      (/var/lib/flatpak/overrides/<id>, written through the `flatpak override` command, system
      installation; the one exception is a RestorePermission that fails halfway, see there); the
      override is the only record, re-read on every call, and it only ever withdraws. The calls
      that change an override run one at a time, from their read to their last write, also
      against the drop after an uninstall. The options it writes (each with two leading dashes, which an XML comment cannot
      hold):
        network      unshare=network
        home-files   nofilesystem=<path> for every path that makes it up (home, ~/..., xdg-...)
        host-files   nofilesystem=<path> for every path that makes it up (host, host-os,
                     host-etc, an absolute path)
        all-devices  nodevice=all, device=input and device=dri: the app keeps its controllers
                     and its GPU (both are a part of all devices); each of the two only when the
                     app names it nowhere else (its own entry keeps it, a negated one stays);
                     not-withdrawable on a Flatpak without device=input (before 1.15.6)
        audio        not-withdrawable: output and microphone share the one PulseAudio socket
        session-bus  not-withdrawable: apps break unpredictably without it
        gamepad      not-withdrawable: a console keeps its controllers
      A change applies the next time the app starts; a running app keeps what it started with.
      An override written outside the Store (an admin with a shell) is reported as it is, also
      when it adds a key; ResetPermissions removes it, and RestorePermission rewrites the override
      (see there). Uninstall drops the app's override. No app reaches a Ruya service whatever its
      permissions: every org.ruyaos.* policy admits only ruya-shell and root.

      GetPermissions is open to the shell for every profile (a Standard profile sees them
      read-only); the other three need an admin (root, or the shell while the active profile is
      an admin). Statuses: "ok", "invalid" (a malformed id, see above for a key), "unknown-app" (no
      installed app with that id), "not-withdrawable", "forbidden", "failed" (the metadata or the
      override could not be read or written). Each reads Flatpak's installed set first, like
      Install (InstalledChanged).
    -->

    <!-- effective: what the app gets now (its metadata with the override on top), in contract order.
         withdrawn: the keys of its metadata the override takes away. withdrawable: the keys of its
         metadata WithdrawPermission accepts on this console, withdrawn now or not. All empty unless
         status is "ok". -->
    <method name="GetPermissions">
      <arg name="app_id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="effective" type="as" direction="out"/>
      <arg name="withdrawn" type="as" direction="out"/>
      <arg name="withdrawable" type="as" direction="out"/>
    </method>

    <!-- Adds the key's withdrawal to the app's override. "ok" also when it is withdrawn already. -->
    <method name="WithdrawPermission">
      <arg name="app_id" type="s" direction="in"/>
      <arg name="key" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- Gives a withdrawn key back. Flatpak cannot take back one option of an override, so the
         override is reset and the keys that stay withdrawn are withdrawn again: what else an
         override written outside the Store held goes with it. "ok" also when it is not withdrawn.
         It never fails open: when the second step fails after the reset, the service writes the
         override it read at the start back to its file and answers "failed". -->
    <method name="RestorePermission">
      <arg name="app_id" type="s" direction="in"/>
      <arg name="key" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- Removes the app's override (the reset option of flatpak override), whoever wrote it: the app has what
         its metadata asks for again. "ok" also without one. -->
    <method name="ResetPermissions">
      <arg name="app_id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- phase: "download" | "install" | "update" | "remove"; percent 0-100, never decreasing within a job. -->
    <signal name="JobProgress">
      <arg name="job" type="s"/>
      <arg name="percent" type="u"/>
      <arg name="phase" type="s"/>
    </signal>

    <!-- Always sent once per job; InstalledChanged for a successful job comes first. -->
    <signal name="JobFinished">
      <arg name="job" type="s"/>
      <arg name="status" type="s"/>
    </signal>

    <!-- The set of installed apps, or an app's update flag, changed: call ListInstalled again (the
         installed and update_available flags of apps already held change with it). Not sent for a
         catalogue re-read that changed no installed state. Also sent when a call that reads Flatpak
         (Install, Uninstall, Update, Rollback, ListInstalled, the permission calls) finds the installed set changed outside
         the Store (flatpak uninstall by hand), once per change; it may arrive before that call's reply. -->
    <signal name="InstalledChanged"/>

    <!-- The catalogue was (re)read: after the service first read it, after an AppStream refresh and
         after AddRemote. Call Search again. -->
    <signal name="CatalogChanged"/>

  </interface>
</node>
