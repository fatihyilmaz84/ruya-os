<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.ruyaos.Store1 — the app store: search, install, update, uninstall Flatpak apps.
  Served by ruya-store on the system bus at /org/ruyaos/Store1 (ruya-store, T-134; the shell's mock
  backend follows this contract too).
  Contract between shell (Qt/QML) and services (Rust); see docs/specs/03-services-and-apps.md §4.

  Status strings are stable API:
    "ok"                success (for Install/Uninstall/Update: the job was queued, its result
                        arrives with JobFinished)
    "unknown-app"       no app with that id
    "already-installed" Install of an installed app
    "not-installed"     Uninstall/Update/Rollback of an app that is not installed
    "no-update"         Update of an app with no update available
    "busy"              a job for that app is already queued or running
    "forbidden"         the caller is not allowed (AddRemote needs an admin; high-risk
                        permissions need the admin PIN, which the shell checks via Profiles1)
    "invalid"           malformed argument
    "failed"            internal error

  JobFinished statuses (a job is a queued transaction; there is one transaction queue):
    "ok"                done
    "failed"            internal error
    "network"           the remote could not be reached
    "signature"         a commit or remote failed signature verification
    "missing-runtime"   a runtime the app needs could not be installed
    "disk-full"         not enough space

  Jobs are named by an opaque string returned from Install/Uninstall/Update/Rollback.

  Every list is a plain array and every record an a{sv} dictionary, so fields can be added later
  without breaking clients (unknown keys are ignored). The installed list is re-read after InstalledChanged,
  the catalogue (Search) after CatalogChanged.

  App record (a{sv}), keys:
    id              s    Flatpak application id, e.g. "org.example.Racer"
    name            s    display name
    summary         s    one line
    description     s    long text, plain
    developer       s    developer or publisher name
    source          s    "official" | "community" | "developer" (spec §4.2: the remote's trust level)
    controller      s    "full" | "partial" | "none" (x-ruya-controller / <control>gamepad)
    age_rating      s    OARS summary: "all" | "7+" | "12+" | "16+" | "18+"; absent for an app
                         with no content rating (not rated; a client must not read it as "all")
    permissions     as   (GetApp reads them on first use; the lists carry the ones already read)
                         stable keys, in plain-language order: "network", "home-files",
                         "host-files", "all-devices", "audio", "gamepad", "session-bus", ...
                         (unknown keys are shown by the shell as-is)
    new_permissions as   what the available update adds to the installed version's permissions (same
                         keys as permissions, in the new version's order); empty when the app is
                         not installed, has no update or the update adds nothing. Only GetApp
                         fills it (it reads the installed and the new version's metadata, the new
                         one fresh each time); the lists carry an empty array. A Standard profile
                         needs the admin PIN for an update that adds a high-risk permission.
    installed_size  t    bytes on disk when installed (download size is not exposed)
    icon            s    URL (https: or file:) or "" - the shell draws a generated tile then
    tile            s    URL or ""
    hero            s    URL or ""
    installed       b
    update_available b   only ever true when installed
-->
<node>
  <interface name="org.ruyaos.Store1">

    <!--
      Apps whose name, summary or id contains the query (case-insensitive). "" returns the whole catalogue.
      options (a{sv}, unknown keys are ignored, {} = no filter):
        controller  s   "any" (default) | "gamepad" (controller "full" or "partial" only)
        limit       u   at most this many apps, 0 = no limit (default)
      A bad value of a known key makes the call fail with org.freedesktop.DBus.Error.InvalidArgs.
    -->
    <method name="Search">
      <arg name="query" type="s" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="apps" type="aa{sv}" direction="out"/>
    </method>

    <!-- One app, with its permissions and (for an installed app with an update) new_permissions
         read now. The shell calls it when an app page opens. status "unknown-app" returns an empty
         dictionary. -->
    <method name="GetApp">
      <arg name="id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="app" type="a{sv}" direction="out"/>
    </method>

    <method name="ListInstalled">
      <arg name="apps" type="aa{sv}" direction="out"/>
    </method>

    <!-- Queue an installation. job is "" unless status is "ok". -->
    <method name="Install">
      <arg name="id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="job" type="s" direction="out"/>
    </method>

    <!-- Queue an uninstall; delete_data also removes ~/.var/app/<id> of every profile. -->
    <method name="Uninstall">
      <arg name="id" type="s" direction="in"/>
      <arg name="delete_data" type="b" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="job" type="s" direction="out"/>
    </method>

    <method name="Update">
      <arg name="id" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="job" type="s" direction="out"/>
    </method>

    <!-- Go back to an earlier commit of an installed app (no UI yet). -->
    <method name="Rollback">
      <arg name="id" type="s" direction="in"/>
      <arg name="commit" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
      <arg name="job" type="s" direction="out"/>
    </method>

    <!--
      The service's job table: the jobs queued or running and the last finished ones (the 20 most
      recent), oldest first. The shell calls it when it (re)connects, because a client that was away
      (the service restarted, or the shell did) has missed the signals, and replaces what it shows
      by the answer. One dictionary per job:
        id       s   the job name returned by Install/Uninstall/Update/Rollback
        app      s   Flatpak application id
        kind     s   "install" | "remove" (Uninstall) | "update" | "rollback"
        state    s   "queued" | "running" | "finished"
        status   s   "" unless state is "finished", then the JobFinished status ("ok", "failed", ...)
        reason   s   "" or "interrupted": the service died while the job was queued or running and
                     cannot resume Flatpak's transaction. The job then reports state "finished",
                     status "failed" - unless its result is visible in Flatpak (a running install of
                     an installed app, a running remove of an app that is gone): that is status "ok"
                     with no reason. A restarted service never reports a job as queued or running
                     that it did not start itself.
        percent  u   0-100 (100 for an "ok" job, 0 for a queued one)
        phase    s   as JobProgress ("download" | "install" | "update" | "remove")
      Job names continue after a restart (they are never reused). The table is kept in the service's
      state directory, so a finished job can be listed after a restart too. No signal announces a
      restart-time correction: the new bus name owner is the announcement.
    -->
    <method name="ListJobs">
      <arg name="jobs" type="aa{sv}" direction="out"/>
    </method>

    <!--
      Software sources (spec §4.2), one dictionary each:
        name     s   remote name ("ruyaos", "flathub")
        title    s   display name
        trust    s   "official" | "community" | "developer"
        enabled  b
    -->
    <method name="ListRemotes">
      <arg name="remotes" type="aa{sv}" direction="out"/>
    </method>

    <!-- Admin only (no UI yet). Unsigned remotes are refused with status "invalid". -->
    <method name="AddRemote">
      <arg name="name" type="s" direction="in"/>
      <arg name="url" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- phase: "download" | "install" | "update" | "remove"; percent 0-100, never decreasing within a job. -->
    <signal name="JobProgress">
      <arg name="job" type="s"/>
      <arg name="percent" type="u"/>
      <arg name="phase" type="s"/>
    </signal>

    <!-- Always sent once per job; InstalledChanged for a successful job comes first. -->
    <signal name="JobFinished">
      <arg name="job" type="s"/>
      <arg name="status" type="s"/>
    </signal>

    <!-- The set of installed apps, or an app's update flag, changed: call ListInstalled again (the
         installed and update_available flags of apps already held change with it). Not sent for a
         catalogue re-read that changed no installed state. Also sent when a call that reads Flatpak
         (Install, Uninstall, Update, Rollback, ListInstalled) finds the installed set changed outside
         the Store (flatpak uninstall by hand), once per change; it may arrive before that call's reply. -->
    <signal name="InstalledChanged"/>

    <!-- The catalogue was (re)read: after the service first read it, after an AppStream refresh and
         after AddRemote. Call Search again. -->
    <signal name="CatalogChanged"/>

  </interface>
</node>
