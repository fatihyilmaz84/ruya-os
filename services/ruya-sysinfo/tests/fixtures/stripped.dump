# A stripped-down machine: a small virtual machine without GPU, DMI, EFI, swap, drives or
# network. Written for T-226, NOT captured from a machine. Everything the collector cannot read must
# be absent, never zero.
== file /etc/os-release
NAME="RuyaOS"
VERSION_ID=44
