+bool LinuxDmabuf::setMainDevice(dev_t device)
+{
+    Q_ASSERT(resourceMap().isEmpty());
+    struct Entry {
+        uint32_t format;
+        uint32_t pad;
+        uint64_t modifier;
+    };
+    static_assert(sizeof(Entry) == 16, "format table entries are 16 bytes");
+
+    QList<Entry> entries;
+    for (auto it = m_modifiers.constBegin(); it != m_modifiers.constEnd(); ++it) {
+        QList<uint64_t> modifiers = it.value();
+        if (modifiers.isEmpty())
+            modifiers << DRM_FORMAT_MOD_INVALID;
+        for (const auto &modifier : std::as_const(modifiers))
+            entries.append(Entry{ it.key(), 0, modifier });
+    }
+    if (entries.isEmpty() || entries.size() > 0xFFFF)
+        return false;
+
+    const size_t size = size_t(entries.size()) * sizeof(Entry);
+    int fd = memfd_create("linux-dmabuf-feedback-format-table", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+    if (fd < 0)
+        return false;
+    if (ftruncate(fd, off_t(size)) != 0 || pwrite(fd, entries.constData(), size, 0) != ssize_t(size)) {
+        close(fd);
+        return false;
+    }
+    // clients map the table read-only; seal it so it can be shared by all of them
+    fcntl(fd, F_ADD_SEALS, F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE | F_SEAL_SEAL);
+
+    if (m_formatTableFd >= 0)
+        close(m_formatTableFd);
+    m_formatTableFd = fd;
+    m_formatTableSize = uint32_t(size);
+    m_formatTableEntries = uint32_t(entries.size());
+    m_mainDevice = device;
+    return true;
+}
+
+void LinuxDmabuf::sendFeedback(Resource *resource, uint32_t id)
+{
+    LinuxDmabufFeedback::Resource *feedback = m_feedback.add(resource->client(), int(id), resource->version());
+    if (!feedback)
+        return;
+
+    const QByteArray device(reinterpret_cast<const char *>(&m_mainDevice), sizeof(m_mainDevice));
+    QByteArray indices(int(m_formatTableEntries * sizeof(uint16_t)), Qt::Uninitialized);
+    uint16_t *index = reinterpret_cast<uint16_t *>(indices.data());
+    for (uint32_t i = 0; i < m_formatTableEntries; ++i)
+        index[i] = uint16_t(i);
+
+    m_feedback.send_format_table(feedback->handle, m_formatTableFd, m_formatTableSize);
+    m_feedback.send_main_device(feedback->handle, device);
+    m_feedback.send_tranche_target_device(feedback->handle, device);
+    m_feedback.send_tranche_formats(feedback->handle, indices);
+    m_feedback.send_tranche_flags(feedback->handle, 0);
+    m_feedback.send_tranche_done(feedback->handle);
+    m_feedback.send_done(feedback->handle);
+}
+
+void LinuxDmabuf::zwp_linux_dmabuf_v1_get_default_feedback(Resource *resource, uint32_t id)
+{
+    sendFeedback(resource, id);
+}
