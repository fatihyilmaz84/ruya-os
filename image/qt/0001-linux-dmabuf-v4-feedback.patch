+bool LinuxDmabufClientBufferIntegration::findMainDevice(dev_t *device)
+{
+    auto queryDisplayAttrib = reinterpret_cast<PFNEGLQUERYDISPLAYATTRIBEXTPROC>(eglGetProcAddress("eglQueryDisplayAttribEXT"));
+    auto queryDeviceString = reinterpret_cast<PFNEGLQUERYDEVICESTRINGEXTPROC>(eglGetProcAddress("eglQueryDeviceStringEXT"));
+    if (!queryDisplayAttrib || !queryDeviceString) {
+        qCWarning(qLcWaylandCompositorHardwareIntegration) << "linux-dmabuf: no EGL_EXT_device_query, no feedback";
+        return false;
+    }
+
+    EGLAttrib eglDevice = 0;
+    if (!queryDisplayAttrib(m_eglDisplay, EGL_DEVICE_EXT, &eglDevice) || !eglDevice) {
+        qCWarning(qLcWaylandCompositorHardwareIntegration) << "linux-dmabuf: no EGL device for the display, no feedback";
+        return false;
+    }
+
+    QByteArray node;
+    if (const char *renderNode = queryDeviceString(reinterpret_cast<EGLDeviceEXT>(eglDevice), EGL_DRM_RENDER_NODE_FILE_EXT))
+        node = renderNode;
+    if (node.isEmpty()) {
+        // fall back to the primary node and ask libdrm for its render node
+        if (const char *primaryNode = queryDeviceString(reinterpret_cast<EGLDeviceEXT>(eglDevice), EGL_DRM_DEVICE_FILE_EXT)) {
+            int fd = open(primaryNode, O_RDWR | O_CLOEXEC);
+            if (fd >= 0) {
+                if (char *name = drmGetRenderDeviceNameFromFd(fd)) {
+                    node = name;
+                    free(name);
+                }
+                close(fd);
+            }
+        }
+    }
+    if (node.isEmpty()) {
+        qCWarning(qLcWaylandCompositorHardwareIntegration) << "linux-dmabuf: no DRM render node for the EGL device, no feedback";
+        return false;
+    }
+
+    struct stat st;
+    if (stat(node.constData(), &st) != 0 || !S_ISCHR(st.st_mode)) {
+        qCWarning(qLcWaylandCompositorHardwareIntegration) << "linux-dmabuf: cannot stat" << node << ", no feedback";
+        return false;
+    }
+    qCInfo(qLcWaylandCompositorHardwareIntegration) << "linux-dmabuf: main device" << node;
+    *device = st.st_rdev;
+    return true;
 }
 
