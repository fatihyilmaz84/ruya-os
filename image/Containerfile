# RuyaOS bootc image. Build context = repository root:
#   podman build -f image/Containerfile -t localhost/ruyaos:dev .
ARG FEDORA_VERSION=44

# ---- shell (Qt 6 / QML) -------------------------------------------------------------
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION} AS shell-build
RUN dnf -y install --setopt=install_weak_deps=False \
        cmake ninja-build gcc-c++ \
        qt6-qtbase-devel qt6-qtdeclarative-devel qt6-qtmultimedia-devel qt6-qttools-devel qt6-linguist \
        qt6-qtwayland-devel qt6-qtshadertools-devel qt6-qtbase-private-devel \
    && dnf clean all
COPY shell /src/shell
# RUYA_COMPOSITOR: ruya-shell is the Wayland compositor on KMS (ADR-002 option A, T-130).
RUN cmake -S /src/shell -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DRUYA_BUILD_TESTS=OFF -DRUYA_COMPOSITOR=ON \
    && cmake --build /build \
    && DESTDIR=/out cmake --install /build

# ---- Rust services ------------------------------------------------------------------
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION} AS services-build
RUN dnf -y install --setopt=install_weak_deps=False cargo rust && dnf clean all
COPY services /src/services
RUN cd /src/services \
    && cargo build --release --locked \
    && install -Dm755 target/release/ruya-inputd /out/usr/bin/ruya-inputd \
    && install -Dm755 target/release/ruya-profiles /out/usr/bin/ruya-profiles \
    && install -Dm755 target/release/ruya-devices /out/usr/bin/ruya-devices \
    && install -Dm755 target/release/ruya-library /out/usr/bin/ruya-library \
    && install -Dm755 target/release/ruya-session /out/usr/bin/ruya-session \
    && install -Dm755 target/release/ruya-store /out/usr/bin/ruya-store \
    && install -Dm755 target/release/ruya-update /out/usr/bin/ruya-update

# ---- Qt Wayland compositor: linux-dmabuf v4 (T-358) ---------------------------------
# Apps get GPU buffers only through zwp_linux_dmabuf_v1 v4 feedback (Mesa 26 has no wl_drm).
# Fedora's qt6-qtwayland lacks the plugin (an upstream configure bug never finds EGL for the
# dmabuf test) and upstream's plugin speaks only v3. Build just that plugin from the source RPM of
# the same qt6-qtwayland the image installs, with our v4 feedback patch. It uses private Qt API:
# the OS stage below refuses the image when the versions differ.
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION} AS qt-dmabuf
COPY image/qt /src/qt
RUN set -eux; \
    dnf -y install --setopt=install_weak_deps=False cpio patch wayland-protocols-devel qt6-qtwayland; \
    ver="$(rpm -q --qf '%{VERSION}-%{RELEASE}' qt6-qtwayland)"; \
    mkdir /w && cd /w; \
    dnf -y --enablerepo=fedora-source --enablerepo=updates-source download --source "qt6-qtwayland-$ver"; \
    rpm2cpio qt6-qtwayland-*.src.rpm | cpio -idm --quiet; \
    dnf -y builddep --setopt=install_weak_deps=False ./qt6-qtwayland.spec; \
    qtver="$(rpm -q --qf '%{VERSION}' qt6-qtwayland)"; \
    tar xf "qtwayland-everywhere-src-$qtver.tar.xz"; \
    cd "qtwayland-everywhere-src-$qtver"; \
    patch -p1 < /src/qt/0001-linux-dmabuf-v4-feedback.patch; \
    cmake -S . -B /b -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF \
        -DTEST_dmabuf_client_buffer=ON -DCMAKE_SKIP_RPATH=ON > /tmp/configure.log; \
    ninja -C /b QWaylandDmabufClientBufferIntegrationPlugin > /tmp/build.log; \
    plugin=lib64/qt6/plugins/wayland-graphics-integration-server/libqt-wayland-compositor-linux-dmabuf-unstable-v1.so; \
    install -d "/out/usr/$(dirname "$plugin")" /out/usr/share/ruyaos; \
    strip --strip-debug -o "/out/usr/$plugin" "/b/$plugin"; \
    printf 'qt6-qtwayland-%s\nqt6-qtbase-%s\n' "$ver" "$(rpm -q --qf '%{VERSION}-%{RELEASE}' qt6-qtbase)" \
        > /out/usr/share/ruyaos/qt-dmabuf-built-against; \
    dnf clean all

# ---- OS image -----------------------------------------------------------------------
FROM quay.io/fedora/fedora-bootc:${FEDORA_VERSION}
ARG RUYA_VERSION=0.0.0-dev

# Ordered build steps (image/build/NN-*.sh). Bind-mounted, so the scripts are not shipped.
RUN --mount=type=bind,source=image/build,target=/ctx/build \
    /ctx/build/10-repos.sh \
    && /ctx/build/20-base.sh \
    && /ctx/build/30-codecs.sh \
    && /ctx/build/40-nvidia.sh

# Slim the image (T-195): remove what fedora-bootc ships and a console never uses. A layer of its
# own after the NVIDIA one, so a failed removal shows up here and not inside the long chain below.
# (Any edit under image/build/ changes the bind mount of the first RUN too and rebuilds from there.)
RUN --mount=type=bind,source=image/build,target=/ctx/build \
    /ctx/build/50-slim.sh

COPY --from=shell-build /out/ /
COPY --from=services-build /out/ /
COPY --from=qt-dmabuf /out/ /
# The dmabuf plugin (T-358) uses private Qt API: it must match the image's Qt exactly.
RUN want="$(printf 'qt6-qtwayland-%s\nqt6-qtbase-%s' "$(rpm -q --qf '%{VERSION}-%{RELEASE}' qt6-qtwayland)" "$(rpm -q --qf '%{VERSION}-%{RELEASE}' qt6-qtbase)")" \
    && have="$(cat /usr/share/ruyaos/qt-dmabuf-built-against)" \
    && if [ "$want" != "$have" ]; then echo "qt-dmabuf plugin built against: $have; image has: $want" >&2; exit 1; fi

# image/rootfs is installed with cp, not COPY: a checkout on Windows has every file and directory
# at mode 0777, COPY keeps that, and for a directory that a layer introduces (/usr/libexec/ruyaos)
# a later chmod does not survive into the deployed disk (found in T-107). cp --no-preserve=mode
# creates files 0644 and directories 0755 (umask 022); the scripts are made executable right after.
# The last check fails the build if anything we ship is group- or world-writable: a polkit rule,
# PAM file or unit that anyone can edit is a root hole.
RUN --mount=type=bind,source=image/build,target=/ctx/build \
    --mount=type=bind,source=image/rootfs,target=/ctx/rootfs \
    cp -r --no-preserve=mode,ownership /ctx/rootfs/. / \
    && mkdir -p /usr/lib/ruyaos \
    && echo "${RUYA_VERSION}" > /usr/lib/ruyaos/version \
    && chmod 0755 /usr/libexec/ruyaos/wait-shell-ready /usr/libexec/ruyaos/grub-menu-sync /usr/lib/greenboot/check/required.d/*.sh \
    && (cd /ctx/rootfs && find . -mindepth 1 ! -type l -print0 | xargs -0 -I{} find "/{}" -maxdepth 0 -perm /022 > /tmp/writable \
        && test ! -s /tmp/writable || { echo "group/world-writable files shipped from image/rootfs:"; cat /tmp/writable; exit 1; }) \
    && systemctl enable ruya-compositor@tty1.service ruya-inputd.service ruya-profiles.service ruya-session.service ruya-library.service ruya-store.service ruya-update.service ruya-flathub-remote.service ruya-boot-marker.service ruya-grub-menu.service bluetooth.service \
    && systemctl --global enable ruya-devices.service \
    && systemctl enable greenboot-healthcheck.service greenboot-set-rollback-trigger.service \
    && systemctl set-default graphical.target \
    && /ctx/build/96-services.sh \
    && /ctx/build/90-initramfs.sh \
    && /ctx/build/92-branding.sh \
    && /ctx/build/95-var-tmpfiles.sh \
    && /ctx/build/98-guard.sh \
    && /ctx/build/99-cleanup.sh

LABEL containers.bootc=1 \
      org.opencontainers.image.title="RuyaOS" \
      org.opencontainers.image.version="${RUYA_VERSION}" \
      org.opencontainers.image.licenses="GPL-3.0-or-later AND (MIT OR Apache-2.0)"

# Warnings are fatal: the image was warning-free as of 0.0.2, keep it that way.
RUN bootc container lint --fatal-warnings
