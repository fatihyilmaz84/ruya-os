# VM-only: tells the CI boot test (via the serial port) that the shell presented a frame.
[Unit]
Description=Report RuyaOS shell readiness on the serial console (VMs only)
ConditionVirtualization=vm
ConditionPathExists=/dev/ttyS0
After=ruya-compositor@tty1.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'if /usr/libexec/ruyaos/wait-shell-ready 120; then echo "RUYA_BOOT_OK $(cat /usr/lib/ruyaos/version)" > /dev/ttyS0; else echo "RUYA_BOOT_FAIL $(cat /usr/lib/ruyaos/version)" > /dev/ttyS0; fi'
# Hardening (RUY-18): it only reads the journal (journalctl -b, as root: the journal files are root's,
# so no capability is needed), /usr/lib/ruyaos/version and the passwd entry of ruya-shell, and writes
# one line to /dev/ttyS0 (root's own device node). No ProcSubset=pid: journalctl -b reads the boot id
# from /proc/sys/kernel/random/boot_id. No PrivateDevices: it would hide /dev/ttyS0; DevicePolicy=closed
# with the one DeviceAllow does that job.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateIPC=yes
DevicePolicy=closed
DeviceAllow=/dev/ttyS0 w
# The PIN store is ruya-profiles' alone, also through /sysroot, where /var comes from (RUY-1130,
# scripts/lint-private-state.ps1).
InaccessiblePaths=/var/lib/ruyaos/profiles /sysroot
NoNewPrivileges=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0077
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
# Both targets: an installer (Anaconda) leaves default.target at multi-user.target (T-178).
WantedBy=graphical.target multi-user.target
