# The console session: ruya-shell is the Wayland compositor itself, directly on KMS (Qt eglfs,
# ADR-002 option A, T-130), started on a VT without a display manager or greeter; profile
# selection happens in the shell. Apps connect to /run/user/<ruya-shell uid>/ruya-0.
# eglfs opens /dev/input/event* itself (no logind TakeDevice): 70-ruya-input.rules lets logind
# give the active seat session (this one) access to them, as it does for the DRM card.
[Unit]
Description=RuyaOS shell and compositor on %I
After=systemd-user-sessions.service plymouth-quit-wait.service
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
Conflicts=getty@%i.service
After=getty@%i.service
Before=graphical.target
ConditionPathExists=/dev/tty0
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=ruya-shell
PAMName=ruya-shell
WorkingDirectory=~
TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=%I
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_kms
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
ExecStart=/usr/bin/ruya-shell
Restart=always
RestartSec=1

[Install]
WantedBy=graphical.target
DefaultInstance=tty1
