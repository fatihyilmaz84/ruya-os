[Unit]
Description=RuyaOS platform identity helper (one request of ruya-platform)
# ADR-022 build decision 4 (RUY-1129). A sandboxed caller's /.flatpak-info is 0600 and owned by the
# profile user: reading it through /proc/<pid>/root needs CAP_SYS_PTRACE (another uid's process
# root) and CAP_DAC_READ_SEARCH (the file's mode), which the door must not hold. This helper does
# that read and nothing else: it takes the pid from its own fdinfo of the pidfd it was given, reads
# .flatpak-info only when the request's uid owns it (so a file bind-mounted there is never read)
# and /proc/<pid>/cgroup, returns the bytes and exits. It parses nothing.
# One instance per connection: a failed one (a request the door gave up on) is logged and unloaded,
# not left behind as a failed unit.
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/libexec/ruya-platform-identify
StandardInput=socket
# The socket carries the reply only; the one log line goes to the journal.
StandardOutput=journal
StandardError=journal
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
# The callers are processes of profile users: ptraceable keeps them visible.
ProtectProc=ptraceable
ProcSubset=pid
# No bus, no network, one task, a few seconds.
InaccessiblePaths=/run/dbus
PrivateNetwork=yes
RestrictAddressFamilies=none
TasksMax=1
RuntimeMaxSec=5s
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
NoNewPrivileges=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0077
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
