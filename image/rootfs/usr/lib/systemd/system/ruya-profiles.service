[Unit]
Description=RuyaOS profiles service (org.ruyaos.Profiles1)
Before=ruya-compositor@tty1.service
# The profiles' Unix users are made and removed by the accounts helper (ADR-049).
Wants=ruya-accounts.socket
After=ruya-accounts.socket

[Service]
Type=dbus
BusName=org.ruyaos.Profiles1
# ADR-049 (RUY-1264): the PIN hashes' holder runs as its own user (sysusers.d/ruyaos.conf) with no
# capability and runs no program (scripts/lint-private-state.ps1): a child would be dumpable again
# after execve and live in this mount namespace. It makes itself non-dumpable before the first read
# (src/process.rs), so even a peer that takes this uid with CAP_SETUID cannot open /proc/<pid>/root.
# Account work goes to ruya-accounts.socket; whether an id is taken is asked in-process.
User=ruya-profiles
Group=ruya-profiles
# No step of this unit runs as root (no "+" or "!" Exec prefix, lint-private-state.ps1 rule 5):
# there is no migration of an older image's store (owner, 2026-11-27: RuyaOS has no installs to
# migrate). A store an older image wrote as root is not readable here: the service then fails
# (EACCES), it never starts with an empty store.
ExecStart=/usr/bin/ruya-profiles
Restart=on-failure
# /var/lib/ruyaos/profiles/profiles.toml: the directory 0700 and the file 0600, both ruya-profiles'.
# Every other root ruya-* unit but the exceptions in image/security-baseline.json private_state
# hides profiles/ and /sysroot (InaccessiblePaths, scripts/lint-private-state.ps1).
StateDirectory=ruyaos/profiles
StateDirectoryMode=0700
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
PrivateIPC=yes
NoNewPrivileges=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0077
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
