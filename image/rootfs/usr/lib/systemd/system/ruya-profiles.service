[Unit]
Description=RuyaOS profiles service (org.ruyaos.Profiles1)
Before=ruya-compositor@tty1.service

[Service]
Type=dbus
BusName=org.ruyaos.Profiles1
ExecStart=/usr/bin/ruya-profiles
Restart=on-failure
# /var/lib/ruyaos/profiles/profiles.toml (the directory 0700, the file 0600) and new profile users
# in /etc + /var/home. The whole of /var/lib/ruyaos is writable here: the first start of this image
# renames an older image's /var/lib/ruyaos/profiles.toml into profiles/ (RUY-1130). Every other
# root ruya-* unit but the exceptions in image/security-baseline.json private_state hides profiles/
# and /sysroot (InaccessiblePaths, scripts/lint-private-state.ps1), and the service makes itself
# non-dumpable at start, so /proc/<pid>/root does not lead around that; 0755 here keeps the tree's
# other directories (library, notifications, platform) reachable.
StateDirectory=ruyaos
StateDirectoryMode=0755
ReadWritePaths=/etc /var/home
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
PrivateIPC=yes
NoNewPrivileges=yes
# Root only for useradd: write /etc/passwd, /etc/shadow (mode 0000), create and chown the home
# and copy /etc/skel. Nothing else (T-126; checked with scripts/vm-profiles-check.sh create).
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# useradd sets the modes of what it writes explicitly; the store is written 0600 anyway.
UMask=0077
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
