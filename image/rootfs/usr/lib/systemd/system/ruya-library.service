[Unit]
Description=RuyaOS library service (org.ruyaos.Library1)
Before=ruya-compositor@tty1.service

[Service]
Type=dbus
BusName=org.ruyaos.Library1
ExecStart=/usr/bin/ruya-library
Restart=on-failure
# Its own unprivileged account (sysusers.d/ruyaos.conf). It only reads: the system Flatpak
# installation (/var/lib/flatpak, readable by everyone) and runs `flatpak list --system`.
# Steam libraries live in the profiles' homes and are not served by the image (spec 03 §5):
# ProtectHome hides /home and /var/home, and HOME is /tmp, so Steam finds nothing.
User=ruya-library
Group=ruya-library
# flatpak fails with "Read-only file system" when HOME is missing (found in the first VM run);
# /tmp is the service's own PrivateTmp.
Environment=HOME=/tmp
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0077
MemoryDenyWriteExecute=yes
# ostree (inside flatpak) reads /proc/sys/kernel/random/boot_id: no ProcSubset=pid.
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_UNIX: the system bus. No network at all.
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
