[Unit]
Description=RuyaOS platform service (org.ruyaos.Platform1, the one door for sandboxed apps)
# Profile ids and the active profile come from Profiles1; without it every app call is refused and
# the service asks again (RUY-1098), so the profile service comes first.
Wants=ruya-profiles.service
After=ruya-profiles.service
# Who a caller is comes from the identity helper (ADR-022 decision 4); without it every app call
# is refused (not-an-app).
Wants=ruya-platform-identify.socket
After=ruya-platform-identify.socket
Before=ruya-compositor@tty1.service

[Service]
Type=dbus
BusName=org.ruyaos.Platform1
ExecStart=/usr/bin/ruya-platform
Restart=on-failure
# The player's permissions, one root-only file per profile:
# /var/lib/ruyaos/platform/profiles/<id>.json (0600). The only place this service writes.
StateDirectory=ruyaos/platform
StateDirectoryMode=0700
# Caller identity (ADR-022, RUY-157): the door is the most exposed root service (every sandbox
# talks to it), so it holds no capability (ADR-022 build decision 4, RUY-1129). A caller's
# .flatpak-info is 0600 and owned by the profile user; the door hands the caller's pidfd to
# ruya-platform-identify.socket, whose helper reads it with CAP_SYS_PTRACE and
# CAP_DAC_READ_SEARCH and returns bytes, never a path. The door reads only its own
# /proc/self/fdinfo, so every other process stays invisible to it.
CapabilityBoundingSet=
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
PrivateIPC=yes
NoNewPrivileges=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0077
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
