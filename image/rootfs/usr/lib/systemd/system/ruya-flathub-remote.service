[Unit]
Description=Add the Flathub remote (signed, from the key in the image) once
ConditionPathExists=!/var/lib/flatpak/.ruya-flathub-initialized
Before=ruya-store.service flatpak-system-helper.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Fedora's own OCI remote is not wanted (its apps have no names in AppStream); it may exist on a
# system that was installed before this unit did. No network is needed: the .flatpakrepo carries
# Flathub's signing key.
ExecStart=-/usr/bin/flatpak remote-delete --system --force fedora
ExecStart=-/usr/bin/flatpak remote-delete --system --force fedora-testing
ExecStart=/usr/bin/flatpak remote-add --system --if-not-exists --title Flathub flathub /usr/lib/fedora-third-party/conf.d/fedora-flathub.flatpakrepo
ExecStartPost=/usr/bin/touch /var/lib/flatpak/.ruya-flathub-initialized
ReadWritePaths=/var/lib/flatpak /var/tmp
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# The PIN store is ruya-profiles' alone, also through /sysroot, where /var comes from (RUY-1130,
# scripts/lint-private-state.ps1).
InaccessiblePaths=/var/lib/ruyaos/profiles /sysroot
NoNewPrivileges=yes
# Hardening (RUY-18): root, but every file it writes is root's own (/var/lib/flatpak), so it needs no
# capability. No UMask=0077: the remote's files must stay readable to ruya-library and the profile users.
# Inet families stay allowed although remote-add fetches nothing (the .flatpakrepo carries the key):
# flatpak's libraries may resolve or probe, and a refused socket() would fail the unit at first boot.
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateDevices=yes
PrivateIPC=yes
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
