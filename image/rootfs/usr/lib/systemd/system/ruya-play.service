[Unit]
Description=RuyaOS .play importer (org.ruyaos.Play1)
Before=ruya-compositor@tty1.service

[Service]
Type=dbus
BusName=org.ruyaos.Play1
ExecStart=/usr/bin/ruya-play
Restart=on-failure
Environment=HOME=/var/lib/ruya-play
# /var/lib/ruya-play: incoming/, state/, the trust store, the staging OSTree repo and the device
# key (root, 0700; docs/specs/05-play-packages.md section 7.1).
StateDirectory=ruya-play
StateDirectoryMode=0700
# /var/lib/flatpak: the system installation the app is committed to. /var/lib/private: the
# helpers' StateDirectory folders and the service's own ruya-play-work/{staging,inspect}, which
# the helpers' output is renamed into. They must share this one mount: every path here and the
# StateDirectory is a mount of its own, and a rename between two mounts is EXDEV (RUY-866).
# /run/ruya-play: the shell's copy of the vetted Inspect art (RUY-1038; another mount than /var/lib/private,
# so it is copied, never renamed).
# /var/tmp: flatpak's temporary files. Removable media under /run/media stays read-only
# (ProtectSystem=strict); the helper gets the package as a descriptor, never a writable path.
ReadWritePaths=/var/lib/flatpak /var/lib/private /run/ruya-play /var/tmp
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
# The PIN store is ruya-profiles' alone, also through /sysroot, where /var comes from (RUY-1130,
# scripts/lint-private-state.ps1).
InaccessiblePaths=/var/lib/ruyaos/profiles /sysroot
NoNewPrivileges=yes
# Root for the commit: the staged tree is owned by the helper's released dynamic uid and is made
# root's (chown, chmod) before ostree commits it; flatpak's checkout writes files of root. No
# CAP_SETUID/CAP_SETGID: nothing switches users. systemd-run (the helper unit) is a D-Bus call to
# the manager and needs no capability.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# Files the commit writes into /var/lib/flatpak must be readable by every profile; the private
# state is kept private by StateDirectoryMode and the importer's own 0600/0700 modes.
UMask=0022
# ostree reads /proc/sys/kernel/random/boot_id: no ProcSubset=pid.
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_UNIX: the bus, the manager (systemd-run) and flatpak's helpers. AF_INET/AF_INET6: flatpak
# fetches a missing runtime of an imported app from the configured remotes. The helper that reads
# packages has no network at all (PrivateNetwork=yes, IPAddressDeny=any).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
