# Audio outputs and volumes for the shell (org.ruyaos.Devices1.Audio), ADR-010. A user unit of
# ruya-shell: it needs the shell's PipeWire. It owns its name on the system bus from code (a
# user unit has no BusName= for the system bus), so Type=simple; the shell retries until the
# name appears.
[Unit]
Description=RuyaOS devices service (org.ruyaos.Devices1)
ConditionUser=ruya-shell
Wants=wireplumber.service
After=wireplumber.service

[Service]
Type=simple
ExecStart=/usr/bin/ruya-devices
Restart=on-failure
RestartSec=1
# Channel levels: $STATE_DIRECTORY/audio.toml (under the user's ~/.local/state).
StateDirectory=ruya-devices
StateDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
# Storage.SaveReport (T-226) writes the system report to a USB drive that udisks mounted under
# /run/media/<user>/: the only place besides the state directory this unit may write.
ReadWritePaths=-/run/media
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=default.target
