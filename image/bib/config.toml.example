# Copy to image/bib/config.toml (git-ignored) for DEV disk images only. It replaces disk.toml,
# so keep the filesystem size from there.
# Gives you SSH access into the VM; release images get no users here.
[[customizations.user]]
name = "root"
key = "ssh-ed25519 AAAA... you@host"

[[customizations.filesystem]]
mountpoint = "/"
minsize = "40 GiB"
