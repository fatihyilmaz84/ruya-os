{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruyaos.org/schemas/input-profile-v1.json",
  "title": "Ruya Input controller profile, version 1",
  "description": "A controller profile of Ruya Input (docs/specs/06-input.md section 7). Validated by ruya-inputd on load, save and import; unknown fields are refused. Limits that a schema cannot express (the total macro duration of 10 s, at most 8 levels of inheritance, no cycles, 64 KiB per file) are checked by the service.",
  "type": "object",
  "required": ["schema_version", "id", "name", "scope"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "maxLength": 512 },
    "scope": { "$ref": "#/$defs/scope" },
    "inherits": { "$ref": "#/$defs/id" },
    "match": { "$ref": "#/$defs/match" },
    "output": { "$ref": "#/$defs/output" },
    "mappings": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/mapping" } },
    "layers": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/layer" } },
    "chords": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/chord" } },
    "macros": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/macro" } },
    "settings": { "$ref": "#/$defs/settings" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "scope": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": { "type": { "enum": ["builtin", "global"] } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "platform_id"],
          "properties": { "type": { "const": "platform" }, "platform_id": { "$ref": "#/$defs/appId" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "game_id"],
          "properties": { "type": { "const": "game" }, "game_id": { "$ref": "#/$defs/appId" } }
        }
      ]
    },
    "appId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$" },
    "match": {
      "description": "Limits the profile to one controller family or one stable device id (06-input.md 4.1). Absent: every controller.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "family": { "enum": ["xbox", "playstation", "nintendo", "generic"] },
        "device": { "type": "string", "pattern": "^[a-z0-9:-]{1,64}$" }
      }
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": { "type": { "enum": ["xbox", "playstation", "generic", "keyboard_mouse", "none"] } }
    },
    "input": {
      "description": "A normalised input (06-input.md 4.2) or a raw source event.",
      "oneOf": [
        {
          "enum": ["south", "east", "west", "north", "l1", "r1", "l3", "r3", "start", "select", "guide",
                   "dpad_up", "dpad_down", "dpad_left", "dpad_right", "paddle1", "paddle2", "paddle3", "paddle4",
                   "misc1", "touchpad_click", "left_x", "left_y", "right_x", "right_y", "left_trigger", "right_trigger",
                   "gyro_x", "gyro_y", "gyro_z", "touchpad"]
        },
        {
          "type": "object", "additionalProperties": false, "required": ["raw"],
          "properties": {
            "raw": {
              "type": "object", "additionalProperties": false, "required": ["node", "type", "code"],
              "properties": {
                "node": { "enum": ["pad", "motion", "touchpad"] },
                "type": { "type": "integer", "minimum": 0, "maximum": 31 },
                "code": { "type": "integer", "minimum": 0, "maximum": 767 }
              }
            }
          }
        }
      ]
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "enum": ["button", "axis", "key", "mouse_button", "mouse_move", "scroll", "layer", "macro", "action", "none"] },
        "code": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
        "invert": { "type": "boolean" },
        "scale": { "type": "number", "minimum": -8, "maximum": 8 }
      }
    },
    "mapping": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/input" },
        "to": { "$ref": "#/$defs/target" },
        "mode": { "enum": ["press", "hold", "toggle", "long_press", "double_press", "turbo"] },
        "hold_ms": { "type": "integer", "minimum": 100, "maximum": 5000 },
        "turbo_hz": { "type": "number", "minimum": 1, "maximum": 30 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "layer": {
      "type": "object", "additionalProperties": false, "required": ["id", "activation", "mappings"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "activation": { "enum": ["momentary", "toggle", "conditional"] },
        "trigger": { "$ref": "#/$defs/input" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 7 },
        "mappings": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/mapping" } }
      }
    },
    "chord": {
      "type": "object", "additionalProperties": false, "required": ["inputs", "to"],
      "properties": {
        "inputs": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/input" } },
        "to": { "$ref": "#/$defs/target" }
      }
    },
    "macro": {
      "type": "object", "additionalProperties": false, "required": ["id", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "steps": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["type"],
            "properties": {
              "type": { "enum": ["press", "release", "tap", "wait"] },
              "target": { "$ref": "#/$defs/target" },
              "ms": { "type": "integer", "minimum": 10, "maximum": 10000 }
            }
          }
        },
        "cancel_on_release": { "type": "boolean" }
      }
    },
    "stick": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "inner_deadzone": { "type": "number", "minimum": 0, "maximum": 0.9 },
        "outer_deadzone": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "anti_deadzone": { "type": "number", "minimum": 0, "maximum": 0.9 },
        "sensitivity": { "type": "number", "minimum": 0.1, "maximum": 4 },
        "curve": { "enum": ["linear", "precise", "aggressive"] },
        "invert_x": { "type": "boolean" },
        "invert_y": { "type": "boolean" },
        "smoothing": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "settings": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "gyro_enabled": { "type": "boolean" },
        "rumble_enabled": { "type": "boolean" },
        "rumble_strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "left_stick": { "$ref": "#/$defs/stick" },
        "right_stick": { "$ref": "#/$defs/stick" },
        "trigger_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
